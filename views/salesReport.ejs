<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Sales Report</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">


    <style>

        /* ========================================
           BODY
        ======================================== */

        body {

            background-color: #f5f6f8;

            margin: 0;

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;

        }


        /* ========================================
           MAIN LAYOUT
        ======================================== */

        .admin-layout {

            min-height: 100vh;

        }


        /* ========================================
           SIDEBAR
        ======================================== */

        .sidebar {

            background-color: #ffffff;

            min-height: 100vh;

            padding: 25px 18px;

            border-right: 1px solid #e5e7eb;

            position: sticky;

            top: 0;

        }


        .sidebar-title {

            font-size: 20px;

            font-weight: 700;

            margin-bottom: 30px;

            padding-left: 10px;

        }


        .sidebar-section-title {

            font-size: 12px;

            font-weight: 600;

            color: #8a8f98;

            text-transform: uppercase;

            letter-spacing: 0.5px;

            margin-top: 20px;

            margin-bottom: 8px;

            padding-left: 10px;

        }


        .sidebar a {

            display: flex;

            align-items: center;

            gap: 8px;

            text-decoration: none;

            color: #555b65;

            padding: 11px 12px;

            margin-bottom: 4px;

            border-radius: 8px;

            font-size: 14px;

            font-weight: 500;

            transition: all 0.2s ease;

        }


        .sidebar a:hover {

            background-color: #f1f3f5;

            color: #212529;

        }


        .sidebar a.active {

            background-color: #212529;

            color: #ffffff;

        }


        .sidebar a.text-danger {

            color: #dc3545 !important;

        }


        .sidebar a.text-danger:hover {

            background-color: #fff0f0;

        }


        .sidebar hr {

            border: 0;

            border-top: 1px solid #eeeeee;

            margin: 20px 0;

        }


        /* ========================================
           MAIN CONTENT
        ======================================== */

        .main-content {

            padding: 30px;

        }


        /* ========================================
           REPORT CARD
        ======================================== */

        .report-card {

            border: none;

            border-radius: 15px;

        }


        /* ========================================
           STAT CARDS
        ======================================== */

        .stat-card {

            border: none;

            border-radius: 15px;

            transition: 0.2s;

        }


        .stat-card:hover {

            transform: translateY(-3px);

        }


        .stat-icon {

            width: 45px;

            height: 45px;

            border-radius: 10px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 20px;

        }


        /* ========================================
           CUSTOM DATE CONTAINER
        ======================================== */

        #customDateContainer {

            max-width: 600px;

        }


        /* ========================================
           RESPONSIVE
        ======================================== */

        @media (max-width: 767px) {

            .sidebar {

                min-height: auto;

                position: relative;

                border-right: none;

                border-bottom: 1px solid #e5e7eb;

            }


            .main-content {

                padding: 20px;

            }

        }

    </style>

</head>


<body>


<div class="container-fluid">

    <div class="row admin-layout">


        <!-- =========================================
             SIDEBAR
        ========================================== -->

        <div class="col-md-3 col-lg-2 p-0">

