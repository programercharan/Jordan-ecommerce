                                </label>

                                <select id="quickFilter" class="form-select">

    <option value="">
        Select Filter
    </option>

    <option value="today"
        <%= selectedFilter === "today" ? "selected" : "" %>>
        Today
    </option>

    <option value="yesterday"
        <%= selectedFilter === "yesterday" ? "selected" : "" %>>
        Yesterday
    </option>

    <option value="thisWeek"
        <%= selectedFilter === "thisWeek" ? "selected" : "" %>>
        This Week
    </option>

    <option value="thisMonth"
        <%= selectedFilter === "thisMonth" ? "selected" : "" %>>
        This Month
    </option>

    <option value="thisYear"
        <%= selectedFilter === "thisYear" ? "selected" : "" %>>
        This Year
    </option>

    <option value="custom"
        <%= selectedFilter === "custom" ? "selected" : "" %>>
        Custom
    </option>

</select>

                            </div>


                        </div>


                        <!-- =================================
