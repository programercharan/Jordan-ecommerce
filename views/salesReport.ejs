<!-- =================================
     ORDER / PRODUCT DETAILS
================================== -->


<div class="card report-card shadow-sm mt-4">

    <div class="card-body p-4">

        <h5 class="fw-bold mb-4">
            Products Sold
        </h5>

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>

                    <tr>

                        <th>
                            Order ID
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Product
                        </th>

                        <th class="text-center">
                            Qty
                        </th>

                        <th class="text-end">
                            Regular Price
                        </th>

                        <th class="text-end">
                            Offer Discount
                        </th>

                        <th class="text-end">
                            Coupon Discount
                        </th>

                        <th class="text-end">
                            Sale Price
                        </th>

                        <th class="text-end">
                            Paid Amount
                        </th>

                        <th>
                            Payment Method
                        </th>

                        <th>
                            Status
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <% orders.forEach((order) => { %>

                        <tr>

                            <!-- ORDER ID -->

                            <td class="fw-semibold">

                                <%= order.orderId %>

                            </td>


                            <!-- DATE -->

                            <td>

                                <%= new Date(order.createdAt).toLocaleDateString() %>

                            </td>


                            <!-- PRODUCT NAME -->

                            <td>

                                <%= order.productName %>

                            </td>


                            <!-- QUANTITY -->

                            <td class="text-center">

                                <%= order.quantity %>

                            </td>


                            <!-- REGULAR PRICE -->

                            <td class="text-end">

                                ₹<%= Number(order.regularPrice || 0).toFixed(2) %>

                            </td>


                            <!-- OFFER DISCOUNT -->

                            <td class="text-end text-danger">

                                -₹<%= Number(order.offerDiscountAmount || 0).toFixed(2) %>

                            </td>


                            <!-- COUPON DISCOUNT -->

                            <td class="text-end text-danger">

                                -₹<%= Number(order.couponDiscount || 0).toFixed(2) %>

                            </td>


                            <!-- SALE PRICE -->

                            <td class="text-end">

                                ₹<%= Number(order.salePrice || 0).toFixed(2) %>

                            </td>


                            <!-- PAID AMOUNT -->

                            <td class="text-end fw-semibold text-success">

                                ₹<%= Number(order.paidAmount || 0).toFixed(2) %>

                            </td>


                            <!-- PAYMENT METHOD -->

                            <td>

                                <%= order.paymentMethod %>

                            </td>


                            <!-- STATUS -->

                            <td>

                                <span class="badge
                                    <%= order.itemStatus === 'Cancelled'
                                        ? 'bg-danger'
                                        : order.itemStatus === 'Returned'
                                            ? 'bg-warning text-dark'
                                            : order.itemStatus === 'Delivered'
                                                ? 'bg-success'
                                                : 'bg-secondary'
                                    %>">

                                    <%= order.itemStatus %>

                                </span>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>





<!-- =========================================
     JAVASCRIPT
========================================== -->

<script>

    const quickFilter =
        document.getElementById("quickFilter");


    const fromDate =
        document.getElementById("fromDate");


    const toDate =
        document.getElementById("toDate");


    const generateReport =
        document.getElementById("generateReport");


    const customDateContainer =
        document.getElementById("customDateContainer");



    // ========================================
    // QUICK FILTER
    // ========================================

    quickFilter.addEventListener(
        "change",
        function () {

            const filter = this.value;


            // ================================
            // CUSTOM
            // ================================

            if (filter === "custom") {

                customDateContainer
                    .classList
                    .remove("d-none");

                return;

            }


            // ================================
            // HIDE CUSTOM DATE
            // ================================

            customDateContainer
                .classList
                .add("d-none");


            // ================================
            // NO FILTER
            // ================================

            if (!filter) {

                return;

            }


            // ================================
            // CREATE URL
            // ================================

            const url =
                new URL(
                    window.location.href
                );


            // Remove old custom dates

            url.searchParams.delete(
                "startDate"
            );


            url.searchParams.delete(
                "endDate"
            );


            // Set filter

            url.searchParams.set(
                "filter",
                filter
            );


            // Navigate

            window.location.href =
                url.toString();

        }
    );



    // ========================================
    // CUSTOM DATE REPORT
    // ========================================

    generateReport.addEventListener(
        "click",
        function () {


            const startDate =
                fromDate.value;


            const endDate =
                toDate.value;


            // ================================
            // VALIDATION
            // ================================

            if (
                !startDate ||
                !endDate
            ) {

                alert(
                    "Please select both start date and end date."
                );

                return;

            }


            // ================================
            // DATE VALIDATION
            // ================================

            if (
                startDate > endDate
            ) {

                alert(
                    "Start date cannot be greater than end date."
                );

                return;

            }


            // ================================
            // CREATE URL
            // ================================

            const url =
                new URL(
                    window.location.href
                );


            // ================================
            // FILTER
            // ================================

            url.searchParams.set(
                "filter",
                "custom"
            );


            // ================================
            // START DATE
            // ================================

            url.searchParams.set(
                "startDate",
                startDate
            );


            // ================================
            // END DATE
            // ================================

            url.searchParams.set(
                "endDate",
                endDate
            );


            // ================================
            // NAVIGATE
            // ================================

            window.location.href =
                url.toString();

        }
    );

</script>


</body>

</html>
<script>
