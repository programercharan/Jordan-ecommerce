                    </div>

                </div>



                <!-- =================================
                     SUMMARY
                ================================== -->

                <div class="row g-4 mb-4">


                    <!-- TOTAL ORDERS -->

                    <div class="col-xl-3 col-md-6">

                        <div
                            class="card
                                   stat-card
                                   shadow-sm">


                            <div class="card-body p-4">


                                <div
                                    class="d-flex
                                           justify-content-between">


                                    <div>

                                        <p class="text-muted mb-2">

                                            Total Orders

                                        </p>


                                        <h3 class="fw-bold mb-0">

                                            <%= report.totalOrders %>

                                        </h3>

                                    </div>


                                    <div
                                        class="stat-icon bg-light">

                                        <i
                                            class="bi bi-cart-check">
                                        </i>

                                    </div>


                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- TOTAL ITEMS -->

                    <div class="col-xl-3 col-md-6">

                        <div
                            class="card
                                   stat-card
                                   shadow-sm">


                            <div class="card-body p-4">


                                <div
                                    class="d-flex
                                           justify-content-between">


                                    <div>

                                        <p class="text-muted mb-2">

                                            Items Sold

                                        </p>


                                        <h3 class="fw-bold mb-0">

                                            <%= report.totalItems %>

                                        </h3>

                                    </div>


                                    <div
                                        class="stat-icon bg-light">

                                        <i
                                            class="bi bi-box-seam">
                                        </i>

                                    </div>


                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- GROSS SALES -->

                    <div class="col-xl-3 col-md-6">

                        <div
                            class="card
                                   stat-card
                                   shadow-sm">


                            <div class="card-body p-4">


                                <div
