<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Edit Variant</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">

    <style>

        body{
            background:#f5f7fb;
        }

        .sidebar{

            width:250px;

            min-height:100vh;

            background:#212529;

            position:fixed;

            left:0;

            top:0;

        }

        body {
    background-color: #f5f5f5;
}

.sidebar {
    background: #ffffff;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.08);
    min-height: calc(100vh - 40px);
}

.sidebar a {
    display: block;
    padding: 10px 12px;
    text-decoration: none;
    color: #333;
    border-radius: 6px;
    margin-bottom: 6px;
    transition: 0.2s;
}

.sidebar a:hover {
    background-color: #f1f1f1;
    color: #111;
}

.sidebar a.active {
    background-color: #111;
    color: #ffffff;
    font-weight: 600;
}

.sidebar hr {
    margin: 20px 0;
}

.sidebar h6 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
}

.sidebar .logout {
    color: #dc3545;
    font-weight: 700;
}

.sidebar .logout:hover {
    background-color: #fff0f0;
    color: #dc3545;
}

        

        .content{

            margin-left:250px;

            padding:30px;

        }

        .image-preview{

            width:150px;

            height:150px;

            object-fit:cover;

            border-radius:10px;

            border:1px solid #ddd;

        }

        .sizeRow{

            margin-bottom:10px;

        }

    </style>

</head>

<body>

<!-- SIDEBAR -->

<div class="col-md-3">

    <div class="sidebar">

        <h5 class="mb-3">
            Admin Panel
        </h5>


        <!-- DASHBOARD -->

        <a
            href="/admin/dashboard"
            class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>">

            Dashboard

        </a>


        <!-- USER MANAGEMENT -->

        <a
            href="/admin/userManagement"
            class="<%= currentSideBar === 'userManagement' ? 'active' : '' %>">

            User Management

        </a>


        <hr>


        <!-- CATALOG MANAGEMENT -->

        <h6 class="text-muted">
            Catalog Management
        </h6>


        <a
            href="/admin/category/categories"
            class="<%= currentSideBar === 'categories' ? 'active' : '' %>">

            Categories

        </a>


        <a
            href="/admin/product/products"
            class="<%= currentSideBar === 'product' ? 'active' : '' %>">

            Products

        </a>


        <hr>


        <!-- ORDER MANAGEMENT -->

        <h6 class="text-muted">
            Order Management
        </h6>


        <a
            href="/admin/orders"
            class="<%= currentSideBar === 'orders' ? 'active' : '' %>">

            Orders

        </a>


        <a
            href="/admin/coupons"
            class="<%= currentSideBar === 'coupons' ? 'active' : '' %>">

            Coupons

        </a>


        <hr>


        <!-- SALES REPORT -->

        <a
            href="/admin/salesReport"
            class="<%= currentSideBar === 'salesReport' ? 'active' : '' %>">

            Sales Report

        </a>


        <hr>


        <!-- LOGOUT -->

        <a
            href="/admin/logout"
            class="logout">

            Logout

        </a>

    </div>

</div>


<div class="content">

<div class="container">

<div class="card shadow">

<div class="card-header bg-primary text-white">

<h4>

Edit Variant

</h4>

</div>

<div class="card-body">

<% if(errorMsg){ %>

<div class="alert alert-danger">

<%= errorMsg %>

</div>

<% } %>

<form

id="variantForm"

action="/admin/editExistingProductVarient/<%= variant._id %>"

method="POST"

enctype="multipart/form-data" novalidate>

<div class="mb-3">

<label class="form-label">

Product

</label>

<input

type="text"

class="form-control"

value="<%= product.name %>"

readonly>

<input

type="hidden"

name="productId"

value="<%= product._id %>">

</div>

<div class="mb-3">

<label>

Status

</label>

<select

name="list"

class="form-select">

<option

value="active"

<%= variant.list ? "selected":"" %>>

Active

</option>

<option

value="inactive"

<%= !variant.list ? "selected":"" %>>

Inactive

</option>

</select>

</div>

<div class="mb-3">

<label>

Color

</label>

<input

type="text"
id="color"
name="color"

class="form-control"

value="<%= variant.color %>"

required>

<small
class="text-danger"
id="colorError">
</small>

</div>

<div class="row">

<div class="col">

<label>

Regular Price

</label>

<input

type="number"
id="regularPrice"
name="regularPrice"

class="form-control"

value="<%= variant.regularPrice %>">
<small
class="text-danger"
id="regularPriceError">
</small> 
</div>

<div class="col">

<label>

Sale Price

</label>

<input

type="number"
id="salePrice"
name="salePrice"

class="form-control"

value="<%= variant.salePrice %>"

required>

<small
class="text-danger"
id="salePriceError">
</small>
</div>

</div>

<br>

<div id="sizeStockContainer">

    <% variant.sizeAndStock.forEach(each => { %>

    <div class="row size-stock-row">

        <div class="col-md-5">

            <label class="form-label">Size</label>

            <input
                type="number"
                name="size[]"
                class="form-control sizeInput"
                value="<%= each.size %>">

        </div>

        <div class="col-md-5">

            <label class="form-label">Stock</label>

            <input
                type="number"
                name="stock[]"
                class="form-control stockInput"
                value="<%= each.stock %>">

        </div>

        <div class="col-md-2 d-flex align-items-end">

            <button
                type="button"
                class="btn btn-danger removeSizeBtn">

                Remove

            </button>

        </div>

    </div>

    <% }) %>

</div>
<small
    class="text-danger"
    id="sizeAndStockError">
</small>
<button

type="button"

id="addSize"

class="btn btn-secondary mt-2">

Add Size

</button>

<hr>
<!-- Existing Images -->

<h5 class="mb-3">

    Existing Images

</h5>

<div id="previewContainer" class="d-flex flex-wrap mb-3"></div>

<!-- Upload New Images -->

<div class="mb-4">

    <label class="form-label">

        Replace Images (Optional)

    </label>

    <input
        type="file"
        id="images"
        name="images"
        class="form-control"
        accept="image/*"
        multiple>

    <small class="text-muted">

        Leave empty if you don't want to replace the existing images.

    </small>

</div>

<!-- Cropper Preview -->


<hr>

<div class="d-flex justify-content-between">

    <a
        href="/admin/productVariant/<%= product._id %>"
        class="btn btn-secondary">

        Back

    </a>

    <button
        type="submit"
        class="btn btn-primary">

        Save Changes

    </button>

</div>

</form>

</div>

</div>

</div>

</div>
<div
    class="modal fade"
    id="cropperModal"
    tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Crop Image
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body text-center">

                <img
                    id="cropperImage"
                    style="max-width:100%;">

            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                    Cancel

                </button>

                <button
                    type="button"
                    id="cropBtn"
                    class="btn btn-primary">

                    Crop

                </button>

            </div>

        </div>

    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

<script>

const addSizeBtn = document.getElementById("addSize");
const sizeStockContainer = document.getElementById("sizeStockContainer");

addSizeBtn.addEventListener("click", () => {

    const row = document.createElement("div");

    row.className = "row size-stock-row";

    row.innerHTML = `
        <div class="col-md-5">
            <label class="form-label">Size</label>
            <input type="number" name="size[]" class="form-control sizeInput">
        </div>

        <div class="col-md-5">
            <label class="form-label">Stock</label>
            <input type="number" name="stock[]" class="form-control stockInput">
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="button" class="btn btn-danger removeSizeBtn">
                Remove
            </button>
        </div>
    `;

    sizeStockContainer.appendChild(row);
});

document.addEventListener("click",function(e){

    if(e.target.classList.contains("removeSizeBtn")){

        const rows =document.querySelectorAll(".size-stock-row")

        if(rows.length > 1){
            e.target.closest(".size-stock-row").remove()
        }

    }

}
)
let cropper = null

const previewContainer = document.getElementById("previewContainer")
const imageInput = document.getElementById("images")
const cropperImage = document.getElementById("cropperImage")
const cropperModalEl = document.getElementById("cropperModal")

const cropperModal = new bootstrap.Modal(cropperModalEl)

const existingImages = [
<% variant.images.forEach((image, index) => { %>
    { id: <%= index %>, url: "<%= image %>" },
<% }) %>
]

const selectedImages = []
let imageId = existingImages.length

let imageQueue = []




document.addEventListener("DOMContentLoaded", () => {
    renderPreview()
})




function renderPreview() {
    previewContainer.innerHTML = ""

    renderExistingImages()
    renderSelectedImages()
}


/* EXISTING IMAGES */

function renderExistingImages() {

    existingImages.forEach(img => {

        const wrapper = document.createElement("div")
        wrapper.className = "position-relative m-2"

        const image = document.createElement("img")
        image.src = img.url
        image.className = "image-preview"

        const btn = document.createElement("button")
        btn.type = "button"
        btn.innerHTML = "&times;"
        btn.className = "btn btn-danger btn-sm position-absolute top-0 end-0"

        btn.addEventListener("click", () => {

            const index = existingImages.findIndex(i => i.id === img.id)

            if (index !== -1) {
                existingImages.splice(index, 1)
            }

            renderPreview()
        })

        wrapper.appendChild(image)
        wrapper.appendChild(btn)

        previewContainer.appendChild(wrapper)
    })
}


 //NEW CROPPED IMAGES 

function renderSelectedImages() {

    selectedImages.forEach(img => {

        const wrapper = document.createElement("div")
        wrapper.className = "position-relative m-2"

        const image = document.createElement("img")
        image.src = URL.createObjectURL(img.blob)
        image.className = "image-preview"

        const btn = document.createElement("button")
        btn.type = "button"
        btn.innerHTML = "&times;"
        btn.className = "btn btn-danger btn-sm position-absolute top-0 end-0"

        btn.addEventListener("click", () => {

            const index = selectedImages.findIndex(i => i.id === img.id)

            if (index !== -1) {
                selectedImages.splice(index, 1)
            }

            renderPreview()
        })

        wrapper.appendChild(image)
        wrapper.appendChild(btn)

        previewContainer.appendChild(wrapper)
    })
}



   //IMAGE SELECTION FLOW


imageInput.addEventListener("change", (e) => {

    const files = Array.from(e.target.files)

     if (existingImages.length + selectedImages.length + files.length > 4) {

        Swal.fire({
            icon: "error",
            title: "Maximum 4 images allowed"
        });

        imageInput.value = "";   
        return;
    }
    imageQueue = files
    openNextImage()
})


function openNextImage() {

    if (imageQueue.length === 0) return

    const file = imageQueue.shift()

    const reader = new FileReader()

    reader.onload = (event) => {

        cropperImage.src = event.target.result

        setTimeout(() => {
            cropperModal.show()
        }, 50)
    }

    reader.readAsDataURL(file)
}




cropperModalEl.addEventListener("shown.bs.modal", () => {

    if (cropper) cropper.destroy()

    cropper = new Cropper(cropperImage, {
        viewMode: 1,
        autoCropArea: 1,
        movable: true,
        zoomable: true,
        scalable: true,
        rotatable: true,
        aspectRatio: NaN
    })
})




document.getElementById("cropBtn").addEventListener("click", () => {

    const canvas = cropper.getCroppedCanvas()

    canvas.toBlob(blob => {

        selectedImages.push({
            id: imageId++,
            blob
        })

        cropperModal.hide()

        renderPreview()

        openNextImage()

    }, "image/png")
})



   //SUBMIT FORM

   const colorError=document.getElementById("colorError")
const regularPriceError=document.getElementById("regularPriceError")
const salePriceError=document.getElementById("salePriceError")
const sizeAndStockError=document.getElementById("sizeAndStockError")


document.getElementById("variantForm").addEventListener("submit", async (e) => {

    e.preventDefault()

let hasErrorInValidation=false

colorError.innerHTML=""
regularPriceError.innerHTML=""
salePriceError.innerHTML=""
sizeAndStockError.innerHTML=""


const color =document.getElementById("color").value.trim()

const regularPrice =Number(document.getElementById("regularPrice").value)

const salePrice =Number(document.getElementById("salePrice").value)


   if(color === ""){
        hasErrorInValidation=true
colorError.innerText="Color is required"

    }

    if(!regularPrice || regularPrice <= 0){
        hasErrorInValidation=true
regularPriceError.innerHTML="Regular Price invalid"
    }

    if(!salePrice || salePrice <= 0){
    hasErrorInValidation=true
   salePriceError.innerHTML="Sale Price invalid"

    }

    if(salePrice > regularPrice){
    hasErrorInValidation=true
 salePriceError.innerHTML="Sale Price cannot exceed Regular Price"

    }

    const sizes =document.querySelectorAll(".sizeInput")

    const stocks =document.querySelectorAll(".stockInput")

    const sizeSet =new Set()

    for(let i=0;i<sizes.length;i++){

        const size =sizes[i].value
        const stock =stocks[i].value

        if( size === "" ||stock === ""){
            e.preventDefault()
            return Swal.fire({
                icon:"error",
                title:"All Size and Stock fields are required"
            })
        }

        if(sizeSet.has(size)){
            e.preventDefault()
            return Swal.fire({
                icon:"error",
                title:`Size ${size} already added`
            })
        }

        sizeSet.add(size)

    }
    
    if(selectedImages.length+existingImages.length<3){
        e.preventDefault()
        return Swal.fire({
                icon:"error",
                title:"Minimum of 3 images required"
            })
        }

        if(hasErrorInValidation){
        return e.preventDefault()
    }
    const form = e.target
    const formData = new FormData(form)

    formData.delete("images")

    /* existing images */
    existingImages.forEach(img => {
        formData.append("existingImages", img.url)
    })

    /* new images */
    selectedImages.forEach(img => {
        formData.append("images", img.blob, `cropped-${img.id}.png`)
    })

    console.log(<% variant.id%>)

    const res = await fetch("/admin/editExistingProductVarient/<%= variant._id %>", {
        method: "POST",
        body: formData
    })

    const data = await res.json()

    if (data.success) {
        window.location.href = `/admin/productVariant/<%= product._id %>`
    } else {
        Swal.fire({
            icon: "error",
            title: data.message
        })
    }
})

</script>



    