
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Category Management</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">


    <!-- SweetAlert -->

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <style>

        body {

            background-color: #f5f6f8;

            margin: 0;

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;

        }


        /* ==============================
           SIDEBAR
        ============================== */

        .sidebar {

            background-color: #ffffff;

            min-height: 100vh;

            padding: 25px 18px;

            border-right: 1px solid #e5e7eb;

            position: sticky;

            top: 0;

        }


        .sidebar-title {

            font-size: 21px;

            font-weight: 700;

            margin-bottom: 30px;

            padding-left: 10px;

        }


        .sidebar-section {

            font-size: 11px;

            font-weight: 700;

            color: #8a8f98;

            text-transform: uppercase;

            margin-top: 20px;

            margin-bottom: 8px;

            padding-left: 10px;

        }


        .sidebar a {

            display: flex;

            align-items: center;

            gap: 10px;

            text-decoration: none;

            color: #555b65;

            padding: 11px 12px;

            margin-bottom: 4px;

            border-radius: 8px;

            font-size: 14px;

            transition: 0.2s;

        }


        .sidebar a:hover {

            background-color: #f1f3f5;

            color: #212529;

        }


        .sidebar a.active {

            background-color: #212529;

            color: #ffffff;

        }


        .sidebar hr {

            border: 0;

            border-top: 1px solid #eeeeee;

            margin: 20px 0;

        }


        /* ==============================
           MAIN CONTENT
        ============================== */

        .main-content {

            padding: 30px;

        }


        /* ==============================
           CATEGORY CARD
        ============================== */

        .category-card {

            border: none;

            border-radius: 15px;

        }


        .category-card .card-header {

            border-radius: 15px 15px 0 0;

        }


        /* ==============================
           TABLE
        ============================== */

        .table-container {

            background: #ffffff;

            border-radius: 12px;

            overflow: hidden;

        }


        .table {

            margin-bottom: 0;

        }


        .table th {

            white-space: nowrap;

        }


        /* ==============================
           MOBILE
        ============================== */

        @media (max-width: 767px) {

            .sidebar {

                min-height: auto;

                position: relative;

                border-right: none;

                border-bottom: 1px solid #e5e7eb;

            }


            .main-content {

                padding: 20px 15px;

            }

        }

    </style>

</head>


<body>


<div class="container-fluid">

    <div class="row">


        <!-- ==========================================
             SIDEBAR
        =========================================== -->

        <div class="col-md-3 col-lg-2 p-0">

            <div class="sidebar">


                <div class="sidebar-title">

                    Admin Panel

                </div>


                <!-- MANAGEMENT -->

                <div class="sidebar-section">

                    Management

                </div>


                <a
                    href="/admin/userManagement"
                    class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>">

                    <i class="bi bi-people"></i>

                    Users

                </a>



                <!-- Dashboard -->

                <a
                    href="/admin/dashboard"
                    class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>">

                    <i class="bi bi-speedometer2"></i>

                    Dashboard

                </a>
   

                <!-- CATALOG -->

                <div class="sidebar-section">

                    Catalog Management

                </div>


                <a
                    href="/admin/category/categories"
                    class="<%= currentSideBar === 'Category' ? 'active' : '' %>">

                    <i class="bi bi-tags"></i>

                    Categories

                </a>


                <a
                    href="/admin/product/products"
                    class="<%= currentSideBar === 'products' ? 'active' : '' %>">

                    <i class="bi bi-box-seam"></i>

                    Products

                </a>


                <hr>


                <!-- ORDER MANAGEMENT -->

                <div class="sidebar-section">

                    Order Management

                </div>


                <a
                    href="/admin/orders"
                    class="<%= currentSideBar === 'orders' ? 'active' : '' %>">

                    <i class="bi bi-cart-check"></i>

                    Orders

                </a>


                <a
                    href="/admin/coupons"
                    class="<%= currentSideBar === 'coupons' ? 'active' : '' %>">

                    <i class="bi bi-ticket-perforated"></i>

                    Coupons

                </a>


                <a
                    href="/admin/offers/list"
                    class="<%= currentSideBar === 'offers' ? 'active' : '' %>">

                    <i class="bi bi-percent"></i>

                    Offers

                </a>


                <hr>


                <!-- REPORTS -->

                <div class="sidebar-section">

                    Reports

                </div>


                <a
                    href="/admin/sales-report"
                    class="<%= currentSideBar === 'salesReport' ? 'active' : '' %>">

                    <i class="bi bi-bar-chart-line"></i>

                    Sales Report

                </a>


                <hr>


                <!-- LOGOUT -->

                <a
                    href="/admin/logout"
                    class="text-danger fw-bold">

                    <i class="bi bi-box-arrow-right"></i>

                    Logout

                </a>


            </div>

        </div>



        <!-- ==========================================
             MAIN CONTENT
        =========================================== -->

        <div class="col-md-9 col-lg-10">


            <div class="main-content">


                <!-- PAGE HEADER -->

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>

                        <h3 class="fw-bold mb-1">

                            Category Management

                        </h3>

                        <p class="text-muted mb-0">

                            Manage your product categories

                        </p>

                    </div>


                    <a
                        href="/admin/category/addCategory"
                        class="btn btn-dark">

                        <i class="bi bi-plus-lg me-1"></i>

                        Add Category

                    </a>

                </div>



                <!-- CATEGORY CARD -->

                <div class="card category-card shadow-sm">


                    <div class="card-body p-4">


                        <!-- SEARCH & SORT -->

                        <div class="row g-3 mb-4">


                            <div class="col-md-5">

                                <input
                                    id="searchInput"
                                    type="text"
                                    class="form-control"
                                    placeholder="Search Category"
                                    value="<%= search %>">

                            </div>


                            <div class="col-md-2">

                                <button
                                    id="searchBtn"
                                    class="btn btn-dark w-100">

                                    <i class="bi bi-search me-1"></i>

                                    Search

                                </button>

                            </div>


                            <div class="col-md-2">

                                <button
                                    id="clearBtn"
                                    class="btn btn-outline-secondary w-100">

                                    Clear

                                </button>

                            </div>


                            <div class="col-md-3">

                                <select
                                    id="sortSelect"
                                    class="form-select">

                                    <option value="">

                                        Sort By

                                    </option>


                                    <option value="Newest First">

                                        Newest First

                                    </option>


                                    <option value="Oldest First">

                                        Oldest First

                                    </option>


                                    <option value="A - Z">

                                        A - Z

                                    </option>


                                    <option value="Z - A">

                                        Z - A

                                    </option>

                                </select>

                            </div>

                        </div>



                        <!-- TABLE -->

                        <div class="table-responsive table-container">


                            <table
                                class="table table-hover align-middle text-center">


                                <thead class="table-dark">

                                    <tr>

                                        <th>

                                            Category Name

                                        </th>


                                        <th>

                                            Description

                                        </th>


                                        <th>

                                            Status

                                        </th>


                                        <th>

                                            Actions

                                        </th>

                                    </tr>

                                </thead>


                                <tbody>


                                    <% categories.forEach(category => { %>


                                    <tr>


                                        <td class="fw-semibold">

                                            <%= category.categoryName %>

                                        </td>


                                        <td>

                                            <%= category.description %>

                                        </td>


                                        <td>


                                            <% if(category.list){ %>


                                                <span
                                                    class="badge bg-success">

                                                    Active

                                                </span>


                                            <% } else { %>


                                                <span
                                                    class="badge bg-danger">

                                                    Inactive

                                                </span>


                                            <% } %>


                                        </td>


                                        <td>


                                            <!-- EDIT -->

                                            <a
                                                href="/admin/category/editCategory/<%= category._id %>"
                                                class="btn btn-warning btn-sm me-1">

                                                <i class="bi bi-pencil"></i>

                                                Edit

                                            </a>



                                            <!-- ACTIVATE / DEACTIVATE -->


                                            <% if(category.list){ %>


                                                <form
                                                    action="/admin/category/deactivateCategory/<%= category._id %>?page=<%=currentPage%>"
                                                    method="POST"
                                                    style="display:inline;">

                                                    <button
                                                        class="btn btn-danger btn-sm">

                                                        <i class="bi bi-x-circle"></i>

                                                        Deactivate

                                                    </button>

                                                </form>


                                            <% } else { %>


                                                <form
                                                    action="/admin/category/activateCategory/<%= category._id %>?page=<%=currentPage%>"
                                                    method="POST"
                                                    style="display:inline;">

                                                    <button
                                                        class="btn btn-success btn-sm">

                                                        <i class="bi bi-check-circle"></i>

                                                        Activate

                                                    </button>

                                                </form>


                                            <% } %>


                                        </td>


                                    </tr>


                                    <% }) %>


                                </tbody>


                            </table>


                        </div>



                        <!-- PAGINATION -->


                        <nav class="mt-4">


                            <ul class="pagination justify-content-center">


                                <% for(let i=1;i<=totalPages;i++){ %>


                                <li
                                    class="page-item <%= currentPage === i ? 'active' : '' %>">


                                    <a
                                        class="page-link"
                                        href="/admin/category/categories?page=<%= i %>&search=<%= search %>&sort=<%= sort %>">

                                        <%= i %>

                                    </a>


                                </li>


                                <% } %>


                            </ul>


                        </nav>


                    </div>


                </div>


            </div>


        </div>


    </div>

</div>



<!-- Bootstrap JS -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>



<script>


    /* =========================================
       SEARCH
    ========================================= */


    const searchInput =
        document.getElementById("searchInput");


    const searchBtn =
        document.getElementById("searchBtn");


    const clearBtn =
        document.getElementById("clearBtn");



    searchBtn.addEventListener("click", () => {


        const searchInputValue =
            searchInput.value.trim();


        if(searchInputValue !== ""){


            window.location.href =
                `/admin/category/categories?search=${encodeURIComponent(searchInputValue)}`;


        }else{


            window.location.href =
                "/admin/category/categories";

        }

    });



    /* =========================================
       CLEAR
    ========================================= */


    clearBtn.addEventListener("click", () => {


        searchInput.value = "";


        window.location.href =
            "/admin/category/categories";

    });



    /* =========================================
       SORT
    ========================================= */


    const sortSelect =
        document.getElementById("sortSelect");


    sortSelect.addEventListener("change", () => {


        const sortSelectValue =
            sortSelect.value;


        const url =
            new URL(window.location.href);


        url.searchParams.set(
            "sort",
            sortSelectValue
        );


        window.location.href =
            url.href;

    });



    /* =========================================
       SWEET ALERT
    ========================================= */


    const alertData =
        <%- JSON.stringify(alert || null) %>;


    if(alertData){


        Swal.fire({

            icon:
                alertData.type,

            title:
                alertData.message,

            confirmButtonText:
                "OK"

        });

    }

</script>


</body>

</html>

