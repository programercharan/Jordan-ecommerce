<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Order Details</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">


    <!-- SweetAlert -->

    <script
        src="https://cdn.jsdelivr.net/npm/sweetalert2@11">
    </script>


    <style>

        body {
            background-color: #f5f6f8;
            margin: 0;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;
        }


        /* ==============================
           SIDEBAR
        ============================== */

        .sidebar {

            background-color: #ffffff;

            min-height: 100vh;

            padding: 25px 18px;

            border-right: 1px solid #e5e7eb;

            position: sticky;

            top: 0;
        }


        .sidebar-title {

            font-size: 21px;

            font-weight: 700;

            margin-bottom: 30px;

            padding-left: 10px;
        }


        .sidebar-section {

            font-size: 11px;

            font-weight: 700;

            color: #8a8f98;

            text-transform: uppercase;

            margin-top: 20px;

            margin-bottom: 8px;

            padding-left: 10px;
        }


        .sidebar a {

            display: flex;

            align-items: center;

            gap: 10px;

            text-decoration: none;

            color: #555b65;

            padding: 11px 12px;

            margin-bottom: 4px;

            border-radius: 8px;

            font-size: 14px;

            transition: 0.2s;
        }


        .sidebar a:hover {

            background-color: #f1f3f5;

            color: #212529;
        }


        .sidebar a.active {

            background-color: #212529;

            color: #ffffff;
        }


        .sidebar hr {

            border: 0;

            border-top: 1px solid #eeeeee;

            margin: 20px 0;
        }


        /* ==============================
           MAIN CONTENT
        ============================== */

        .main-content {

            padding: 30px;
        }


        /* ==============================
           ORDER CARDS
        ============================== */

        .order-card {

            border: none;

            border-radius: 15px;
        }


        .product-image {

            width: 100px;

            height: 100px;

            object-fit: cover;

            border-radius: 10px;
        }


        .price-box {

            background: #f8f9fa;

            border-radius: 10px;

            padding: 15px;
        }


        .coupon-box {

            background: #fff8e1;

            border: 1px solid #ffe082;

            border-radius: 10px;

            padding: 15px;
        }


        .paid-amount {

            font-size: 20px;

            font-weight: 700;
        }


        .status-badge {

            font-size: 13px;
        }


        .section-title {

            font-weight: 700;

            margin-bottom: 15px;
        }


        /* ==============================
           MOBILE
        ============================== */

        @media (max-width: 767px) {

            .sidebar {

                min-height: auto;

                position: relative;

                border-right: none;

                border-bottom: 1px solid #e5e7eb;
            }


            .main-content {

                padding: 20px 15px;
            }

        }

    </style>

</head>


<body>


<div class="container-fluid">

    <div class="row">


        <!-- ==========================================
             SIDEBAR
        =========================================== -->

        <div class="col-md-3 col-lg-2 p-0">

            <div class="sidebar">


                <div class="sidebar-title">

                    Admin Panel

                </div>


                <!-- MANAGEMENT -->

                <div class="sidebar-section">

                    Management

                </div>


                <a
                    href="/admin/userManagement"
                    class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>">

                    <i class="bi bi-people"></i>

                    Users

                </a>

                <a
                    href="/admin/dashboard"
                    class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>">

                    <i class="bi bi-speedometer2"></i>

                    Dashboard

                </a>
                <hr>


                <!-- CATALOG -->

                <div class="sidebar-section">

                    Catalog Management

                </div>


                <a
                    href="/admin/category/categories"
                    class="<%= currentSideBar === 'categories' ? 'active' : '' %>">

                    <i class="bi bi-tags"></i>

                    Categories

                </a>


                <a
                    href="/admin/product/products"
                    class="<%= currentSideBar === 'product' ? 'active' : '' %>">

                    <i class="bi bi-box-seam"></i>

                    Products

                </a>


                <hr>


                <!-- ORDERS -->

                <div class="sidebar-section">

                    Order Management

                </div>


                <a
                    href="/admin/orders"
                    class="<%= currentSideBar === 'orders' ? 'active' : '' %>">

                    <i class="bi bi-cart-check"></i>

                    Orders

                </a>


                <a
                    href="/admin/coupons"
                    class="<%= currentSideBar === 'coupons' ? 'active' : '' %>">

                    <i class="bi bi-ticket-perforated"></i>

                    Coupons

                </a>


                <a
                    href="/admin/offers/list"
                    class="<%= currentSideBar === 'offers' ? 'active' : '' %>">

                    <i class="bi bi-percent"></i>

                    Offers

                </a>


                <hr>


                <!-- REPORTS -->

                <div class="sidebar-section">

                    Reports

                </div>


                <a
                    href="/admin/sales-report"
                    class="<%= currentSideBar === 'salesReport' ? 'active' : '' %>">

                    <i class="bi bi-bar-chart-line"></i>

                    Sales Report

                </a>


                <hr>


                <!-- LOGOUT -->

                <a
                    href="/admin/logout"
                    class="text-danger fw-bold">

                    <i class="bi bi-box-arrow-right"></i>

                    Logout

                </a>


            </div>

        </div>



        <!-- ==========================================
             MAIN CONTENT
        =========================================== -->

        <div class="col-md-9 col-lg-10">

            <div class="main-content">


                <!-- ========================================= -->
                <!-- ORDER HEADER -->
                <!-- ========================================= -->

                <div class="card shadow-sm order-card">

                    <div class="card-body">


                        <div
                            class="d-flex justify-content-between align-items-center flex-wrap gap-3">


                            <div>

                                <h3 class="fw-bold">

                                    Order Details

                                </h3>


                                <p class="mb-1">

                                    Order ID :

                                    <span class="fw-bold text-primary">

                                        <%= order.orderId %>

                                    </span>

                                </p>


                                <p class="text-muted mb-0">

                                    Order Date :

                                    <%= new Date(order.createdAt).toLocaleString() %>

                                </p>

                            </div>


                            <div>


                                <% if(order.orderStatus === "Delivered"){ %>

                                    <a
                                        href="/user/order/invoice/<%= order._id %>"
                                        class="btn btn-success">

                                        <i class="bi bi-download"></i>

                                        Download Invoice

                                    </a>


                                <% } else { %>

                                    <button
                                        class="btn btn-secondary"
                                        disabled>

                                        Invoice Available After Delivery

                                    </button>

                                <% } %>


                            </div>


                        </div>


                    </div>

                </div>



                <!-- ========================================= -->
                <!-- STATUS CONTROLS -->
                <!-- ========================================= -->

                <div class="row mt-4">


                    <!-- ORDER STATUS -->

                    <div class="col-md-6">


                        <div class="card shadow-sm order-card">

                            <div class="card-body">


                                <h5 class="section-title">

                                    <i class="bi bi-truck"></i>

                                    Order Status

                                </h5>


                                <form
                                    action="/admin/orders/status/<%= order._id %>"
                                    method="POST"
                                    class="d-flex gap-2">


                                    <select
                                        name="status"
                                        class="form-select">


                                        <option
                                            value="Confirmed"
                                            <%= order.orderStatus === "Confirmed" ? "selected" : "" %>>

                                            Confirmed

                                        </option>


                                        <option
                                            value="Shipped"
                                            <%= order.orderStatus === "Shipped" ? "selected" : "" %>>

                                            Shipped

                                        </option>


                                        <option
                                            value="Out for Delivery"
                                            <%= order.orderStatus === "Out for Delivery" ? "selected" : "" %>>

                                            Out for Delivery

                                        </option>


                                        <option
                                            value="Delivered"
                                            <%= order.orderStatus === "Delivered" ? "selected" : "" %>>

                                            Delivered

                                        </option>


                                    </select>


                                    <button
                                        type="submit"
                                        class="btn btn-dark">

                                        Update

                                    </button>


                                </form>


                                <div class="mt-3">

                                    Current Status :

                                    <span
                                        class="badge bg-primary status-badge">

                                        <%= order.orderStatus %>

                                    </span>

                                </div>


                            </div>

                        </div>

                    </div>



                    <!-- PAYMENT STATUS -->

                    <div class="col-md-6">


                        <div class="card shadow-sm order-card">

                            <div class="card-body">


                                <h5 class="section-title">

                                    <i class="bi bi-credit-card"></i>

                                    Payment Status

                                </h5>


                                <form
                                    action="/admin/orders/payment-status/<%= order._id %>"
                                    method="POST"
                                    class="d-flex gap-2">


                                    <select
                                        name="paymentStatus"
                                        class="form-select">


                                        <option
                                            value="Pending"
                                            <%= order.paymentStatus === "Pending" ? "selected" : "" %>>

                                            Pending

                                        </option>


                                        <option
                                            value="Paid"
                                            <%= order.paymentStatus === "Paid" ? "selected" : "" %>>

                                            Paid

                                        </option>


                                        <option
                                            value="Failed"
                                            <%= order.paymentStatus === "Failed" ? "selected" : "" %>>

                                            Failed

                                        </option>




                                    </select>


                                    <button
                                        type="submit"
                                        class="btn btn-dark">

                                        Update

                                    </button>


                                </form>


                                <div class="mt-3">

                                    Current Status :

                                    <span
                                        class="badge bg-success status-badge">

                                        <%= order.paymentStatus %>

                                    </span>

                                </div>


                            </div>

                        </div>

                    </div>


                </div>



                <!-- ========================================= -->
                <!-- PRODUCTS -->
                <!-- ========================================= -->

                <div class="card shadow-sm mt-4 order-card">


                    <div class="card-body">


                        <h4 class="fw-bold">

                            Products

                        </h4>


                        <hr>


                        <% order.orderItems.forEach(item => { %>


                            <div class="row align-items-center mb-4">


                                <!-- IMAGE -->

                                <div class="col-lg-2 col-md-3">

                                    <img
                                        src="<%= item.productImage %>"
                                        class="product-image">

                                </div>



                                <!-- PRODUCT DETAILS -->

                                <div class="col-lg-3 col-md-4">


                                    <h5 class="fw-bold">

                                        <%= item.productName %>

                                    </h5>


                                    <p class="mb-1">

                                        Size :

                                        <strong>

                                            <%= item.size %>

                                        </strong>

                                    </p>


                                    <p class="mb-1">

                                        Quantity :

                                        <strong>

                                            <%= item.quantity %>

                                        </strong>

                                    </p>


                                    <p class="mb-1">

                                        Item Status :

                                        <span
                                            class="badge bg-secondary">

                                            <%= item.itemStatus %>

                                        </span>

                                    </p>


                                    <p>

                                        Payment :

                                        <span
                                            class="badge bg-info">

                                            <%= item.paymentStatus %>

                                        </span>

                                    </p>


                                </div>



                                <!-- PRICE DETAILS -->

                                <div class="col-lg-4 col-md-5">


                                    <div class="price-box">


                                        <div
                                            class="d-flex justify-content-between mb-1">

                                            <span>

                                                Regular Price

                                            </span>

                                            <strong>

                                                ₹<%= item.regularPrice %>

                                            </strong>

                                        </div>



                                        <% if(item.offerApplied){ %>


                                            <div
                                                class="d-flex justify-content-between text-success mb-1">

                                                <span>

                                                    Offer

                                                </span>

                                                <strong>

                                                    <%= item.offerDiscountPercentage %>%

                                                </strong>

                                            </div>


                                            <div
                                                class="d-flex justify-content-between text-success mb-1">

                                                <span>

                                                    Offer Discount

                                                </span>

                                                <strong>

                                                    -₹<%= item.offerDiscountAmount %>

                                                </strong>

                                            </div>


                                        <% } %>



                                        <div
                                            class="d-flex justify-content-between mb-1">

                                            <span>

                                                Sale Price

                                            </span>

                                            <strong>

                                                ₹<%= item.salePrice %>

                                            </strong>

                                        </div>



                                        <div
                                            class="d-flex justify-content-between mb-1">

                                            <span>

                                                Item Subtotal

                                            </span>

                                            <strong>

                                                ₹<%= item.itemSubtotal %>

                                            </strong>

                                        </div>



                                        <% if(item.couponDiscount > 0){ %>


                                            <div
                                                class="d-flex justify-content-between text-danger mb-1">

                                                <span>

                                                    Coupon Discount

                                                </span>

                                                <strong>

                                                    -₹<%= item.couponDiscount %>

                                                </strong>

                                            </div>


                                        <% } %>



                                        <hr>



                                        <div
                                            class="d-flex justify-content-between">

                                            <span class="fw-bold">

                                                Paid Amount

                                            </span>

                                            <span class="paid-amount">

                                                ₹<%= item.paidAmount %>

                                            </span>

                                        </div>


                                    </div>


                                </div>



                                <!-- ACTIONS -->

                                <div class="col-lg-3 mt-3 mt-lg-0">


                                    <!-- RETURN REQUEST -->

                                    <% if(
                                        item.returnRequest &&
                                        item.returnRequest.requested &&
                                        item.returnRequest.status === "Pending"
                                    ){ %>


                                        <div
                                            class="alert alert-warning p-2">

                                            <strong>

                                                Return Request

                                            </strong>

                                            <br>

                                            Reason:

                                            <%= item.returnRequest.reason %>

                                        </div>


                                        <div
                                            class="d-flex gap-2 mb-3">


                                            <form
                                                action="/admin/orders/return/accept/<%= order._id %>/<%= item._id %>"
                                                method="POST">


                                                <button
                                                    type="submit"
                                                    class="btn btn-success btn-sm">

                                                    Accept Return

                                                </button>


                                            </form>


                                            <form
                                                action="/admin/orders/return/reject/<%= order._id %>/<%= item._id %>"
                                                method="POST">


                                                <button
                                                    type="submit"
                                                    class="btn btn-danger btn-sm">

                                                    Reject Return

                                                </button>


                                            </form>


                                        </div>


                                    <% } %>



                                    <!-- CANCEL REQUEST -->

                                    <% if(
                                        item.cancelRequest &&
                                        item.cancelRequest.requested &&
                                        item.cancelRequest.status === "Pending"
                                    ){ %>


                                        <div
                                            class="alert alert-danger p-2">

                                            <strong>

                                                Cancellation Request

                                            </strong>

                                            <br>

                                            Reason:

                                            <%= item.cancelRequest.reason %>

                                        </div>


                                        <div
                                            class="d-flex gap-2">


                                            <form
                                                action="/admin/orders/cancel/accept/<%= order._id %>/<%= item._id %>"
                                                method="POST">


                                                <button
                                                    type="submit"
                                                    class="btn btn-success btn-sm">

                                                    Accept Cancel

                                                </button>


                                            </form>


                                            <form
                                                action="/admin/orders/cancel/reject/<%= order._id %>/<%= item._id %>"
                                                method="POST">


                                                <button
                                                    type="submit"
                                                    class="btn btn-danger btn-sm">

                                                    Reject Cancel

                                                </button>


                                            </form>


                                        </div>


                                    <% } %>



                                    <!-- RETURN STATUS -->

                                    <% if(
                                        item.returnRequest &&
                                        item.returnRequest.status === "Accepted"
                                    ){ %>


                                        <span
                                            class="badge bg-success">

                                            Return Accepted

                                        </span>


                                    <% } %>


                                    <% if(
                                        item.returnRequest &&
                                        item.returnRequest.status === "Rejected"
                                    ){ %>


                                        <span
                                            class="badge bg-danger">

                                            Return Rejected

                                        </span>


                                    <% } %>



                                    <!-- CANCEL STATUS -->

                                    <% if(
                                        item.cancelRequest &&
                                        item.cancelRequest.status === "Accepted"
                                    ){ %>


                                        <span
                                            class="badge bg-success">

                                            Cancellation Accepted

                                        </span>


                                    <% } %>


                                    <% if(
                                        item.cancelRequest &&
                                        item.cancelRequest.status === "Rejected"
                                    ){ %>


                                        <span
                                            class="badge bg-danger">

                                            Cancellation Rejected

                                        </span>


                                    <% } %>


                                </div>


                            </div>


                            <hr>


                        <% }) %>


                    </div>


                </div>



                <!-- ========================================= -->
                <!-- ORDER SUMMARY -->
                <!-- ========================================= -->

                <div class="row mt-4">


                    <!-- COUPON DETAILS -->

                    <div class="col-md-6">


                        <div class="card shadow-sm order-card">


                            <div class="card-body">


                                <h4 class="fw-bold mb-3">

                                    Coupon Details

                                </h4>


                                <% if(
                                    order.couponDetails &&
                                    order.couponDetails.discountValue > 0
                                ){ %>


                                    <div class="coupon-box">


                                        <div
                                            class="d-flex justify-content-between mb-2">

                                            <span>

                                                Discount Type

                                            </span>

                                            <strong>

                                                <%= order.couponDetails.discountType %>

                                            </strong>

                                        </div>


                                        <div
                                            class="d-flex justify-content-between">

                                            <span>

                                                Discount Value

                                            </span>

                                            <strong>

                                                <% if(
                                                    order.couponDetails.discountType === "percentage"
                                                ){ %>

                                                    <%= order.couponDetails.discountValue %>%

                                                <% } else { %>

                                                    ₹<%= order.couponDetails.discountValue %>

                                                <% } %>

                                            </strong>

                                        </div>


                                        <hr>


                                        <div
                                            class="d-flex justify-content-between">

                                            <span>

                                                Total Coupon Discount

                                            </span>


                                            <strong class="text-danger">

                                                -₹<%= order.orderItems.reduce(
                                                    (total, item) =>
                                                    total + (item.couponDiscount || 0),
                                                    0
                                                ) %>

                                            </strong>

                                        </div>


                                    </div>


                                <% } else { %>


                                    <p class="text-muted mb-0">

                                        No coupon was applied to this order.

                                    </p>


                                <% } %>


                            </div>


                        </div>


                    </div>



                    <!-- ORDER TOTAL -->

                    <div class="col-md-6">


                        <div class="card shadow-sm order-card">


                            <div class="card-body">


                                <h4 class="fw-bold mb-3">

                                    Order Summary

                                </h4>


                                <div
                                    class="d-flex justify-content-between mb-2">

                                    <span>

                                        Subtotal

                                    </span>

                                    <strong>

                                        ₹<%= order.subtotal %>

                                    </strong>

                                </div>



                                <% if(
                                    order.couponDetails &&
                                    order.couponDetails.discountValue > 0
                                ){ %>


                                    <div
                                        class="d-flex justify-content-between text-danger mb-2">

                                        <span>

                                            Coupon Discount

                                        </span>


                                        <strong>

                                            -₹<%= order.orderItems.reduce(
                                                (total, item) =>
                                                total + (item.couponDiscount || 0),
                                                0
                                            ) %>

                                        </strong>

                                    </div>


                                <% } %>



                                <hr>


                                <div
                                    class="d-flex justify-content-between">

                                    <h5 class="fw-bold">

                                        Grand Total

                                    </h5>


                                    <h5 class="fw-bold">

                                        ₹<%= order.grandTotal %>

                                    </h5>

                                </div>


                                <hr>


                                <div
                                    class="d-flex justify-content-between">

                                    <span>

                                        Payment Method

                                    </span>


                                    <strong>

                                        <%= order.paymentMethod %>

                                    </strong>

                                </div>


                                <div
                                    class="d-flex justify-content-between mt-2">

                                    <span>

                                        Payment Status

                                    </span>


                                    <span
                                        class="badge bg-success">

                                        <%= order.paymentStatus %>

                                    </span>

                                </div>


                            </div>

                        </div>

                    </div>


                </div>



                <!-- ========================================= -->
                <!-- SHIPPING ADDRESS -->
                <!-- ========================================= -->

                <div class="card shadow-sm mt-4 order-card">


                    <div class="card-body">


                        <h4 class="fw-bold mb-3">

                            Shipping Address

                        </h4>


                        <p class="mb-1">

                            <strong>

                                <%= order.shippingAddress.firstName %>

                                <%= order.shippingAddress.lastName || "" %>

                            </strong>

                        </p>


                        <p class="mb-1">

                            <%= order.shippingAddress.address %>

                        </p>


                        <p class="mb-1">

                            <%= order.shippingAddress.city %>,

                            <%= order.shippingAddress.state %>

                        </p>


                        <p class="mb-1">

                            PIN :

                            <%= order.shippingAddress.pincode %>

                        </p>


                        <p class="mb-0">

                            Phone :

                            <%= order.shippingAddress.phoneNumber %>

                        </p>


                    </div>


                </div>


            </div>

        </div>

    </div>

</div>

</body>
</html>

















<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>


document.getElementById("paymentStatus").addEventListener("change",async()=>{


const paymentStatus=document.getElementById("paymentStatus").value;


await fetch(
"/admin/orders/payment-status/<%=order._id%>",
{

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({
paymentStatus
})

});


location.reload();


})
</script>

<script>

    const alertData =
        <%- JSON.stringify(alert || null) %>;


    if (alertData) {

        Swal.fire({

            icon:
                alertData.type,

            title:
                alertData.message,

            confirmButtonText:
                "OK"

        });

    }

</script>
</body>

</html>