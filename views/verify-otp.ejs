<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Verify OTP</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
    
</head>
<body class="bg-light">

  <div class="container d-flex justify-content-center align-items-center min-vh-100">

    <div class="card p-4 shadow-sm" style="max-width: 420px; width: 100%;">

      <div id="alert-container">
        <% if (error) { %>
          <div class="alert alert-danger text-center">
            <%= error %>
          </div>
        <% } %>
      </div>

      <h4 class="text-center mb-2">Verify OTP</h4>

      <p class="text-center text-muted mb-4">
        Enter the OTP sent to your email address
      </p>

      <!-- Single form -->
      <form method="post" id="form" novalidate>

        <!-- OTP input -->
        <div class="mb-3">
          <input type="hidden" name="purpose" value="<%=purpose %>" id="purpose">
          <input type="text" class="form-control text-center" name="otp" id="otpInput" placeholder="Enter 6 digit OTP" maxlength="6"required>
          <small id="OtpError" class="text-danger"></small>
        </div>

        <!-- Verify button -->
        <div class="d-grid mb-3">
          <button type="button" class="btn btn-primary" id="verifyOtpBtn" >
            Verify OTP
          </button>
        </div>

        <!-- Timer text -->
        <div class="text-center mb-2">
          <small class="text-muted">
            Resend OTP in
            <span id="timer">02:00</span>
          </small>
        </div>

        <!-- Resend button (same form, different backend route) -->
        <div class="d-grid">
          <button
            type="submit"
            class="btn btn-outline-secondary"
            id="resendBtn"
            formaction="/user/resendotp"
            formmethod="post"
            disabled
          >
            Resend OTP
          </button>
        </div>

      </form>

    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  (function () {
    timerstart()
  })()

  let time = 120

  function timerstart() {
    const timer = document.getElementById("timer")
    const button = document.getElementById("resendBtn")

    button.disabled = true

    const obj = setInterval(() => {

      let seconds = --time
      let minutes = Math.floor(seconds / 60)
      let extraSeconds = seconds % 60

      minutes = minutes < 10 ? "0" + minutes : minutes
      extraSeconds = extraSeconds < 10 ? "0" + extraSeconds : extraSeconds

      timer.innerText = minutes + ":" + extraSeconds

      if (time === 0) {
        clearInterval(obj)
        button.disabled = false
      }
    }, 1000)
  }
const form =document.getElementById("form")
const OtpError=document.getElementById("OtpError")
const verifyOtpBtn=document.getElementById("verifyOtpBtn")
const purposeValue=document.getElementById("purpose").value
OtpError.innerText=""



  verifyOtpBtn.addEventListener("click",async(e)=>{
    e.preventDefault()
   JSON.stringify(console.log("verifyOtpBtn executed..")) 
    const otpValue=document.getElementById("otpInput").value.trim()
    if(!otpValue){
      OtpError.innerText="Enter Valid 6 Digit OTP"
      return e.preventDefault()
    }else
    {
      
      try{
             console.log("before fetch")
            const response=await fetch("/user/verifyotp",{

                method:"post",
                headers:{
                      'Content-Type': 'application/json'
                },
                body:JSON.stringify({
                  otp:otpValue,
                purpose:purposeValue
                })
            })


            const data=await response.json()
            
            if(data.success){
              await Swal.fire({
                icon:"success",
                title:data.message
              })
              window.location.href=data.redirect
            }else{
                const container=document.getElementById("alert-container")
                container.innerHTML=`
                <div id="alert-container">
                  <div class="alert alert-danger text-center">
                ${data.error}
                </div>
                `
            }
          }catch(error){
            console.log(error)
          }
        }

        })


    
</script>

</body>
</html>