<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Product Variant</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />

    <style>

        body{
            background:#f5f5f5;
        }

        .sidebar{
            background:white;
            padding:20px;
            border-radius:10px;
        }

        .sidebar a{
            display:block;
            padding:10px;
            text-decoration:none;
            color:#333;
            border-radius:5px;
            margin-bottom:5px;
        }

        .sidebar a:hover{
            background:#f1f1f1;
        }

        .sidebar a.active{
            background:#0d6efd;
            color:white;
            font-weight:bold;
        }

        .preview-image{
            width:120px;
            height:120px;
            object-fit:cover;
            border-radius:10px;
            border:1px solid #ddd;
            margin:5px;
        }

        .size-stock-row{
            border:1px solid #ddd;
            border-radius:8px;
            padding:10px;
            margin-bottom:10px;
        }



        /* Reset and body rules */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Full-screen loader overlay */
#loader-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #ffffff; /* Change to match your brand color */
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999; /* Ensure it stays on top */
    transition: opacity 0.5s ease, visibility 0.5s ease; /* Smooth fade-out */
}

/* The animated spinning wheel */
.spinner {
    width: 50px;
    height: 50px;
    border: 5px solid #f3f3f3; /* Light grey track */
    border-top: 5px solid #3498db; /* Blue spinning accent */
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

/* Keyframe animation for rotation */
@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Class to fade out the loader via JavaScript */
.loader-hidden {
    opacity: 0;
    visibility: hidden;
}

    </style>


<style>
    body {
        background-color: #f5f5f5;
    }

    .sidebar {
        background: #ffffff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.08);
        min-height: calc(100vh - 40px);
    }

    .sidebar h5 {
        font-weight: 700;
    }

    .sidebar a {
        display: block;
        padding: 10px 12px;
        text-decoration: none;
        color: #333;
        border-radius: 6px;
        margin-bottom: 6px;
        transition: 0.2s;
    }

    .sidebar a:hover {
        background-color: #f1f1f1;
        color: #111;
    }

    .sidebar a.active {
        background-color: #111;
        color: #ffffff;
        font-weight: 600;
    }

    .sidebar hr {
        margin: 20px 0;
    }

    .sidebar h6 {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
    }

    .sidebar .logout {
        color: #dc3545;
        font-weight: 700;
    }

    .sidebar .logout:hover {
        background-color: #fff0f0;
        color: #dc3545;
    }
</style>
</head>

<body>

    <div style="color:red;font-weight:bold;">
    <%= errorMsg %>
</div>
<div class="container mt-5">

    <div class="row">

<!-- Sidebar -->

<!-- SIDEBAR -->

<div class="col-md-3">

    <div class="sidebar">

        <h5 class="mb-3">
            Admin Panel
        </h5>


        <!-- DASHBOARD -->

        <a
            href="/admin/dashboard"
            class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>">

            Dashboard

        </a>


        <!-- USER MANAGEMENT -->

        <a
            href="/admin/userManagement"
            class="<%= currentSideBar === 'userManagement' ? 'active' : '' %>">

            User Management

        </a>


        <hr>


        <!-- CATALOG MANAGEMENT -->

        <h6 class="text-muted">
            Catalog Management
        </h6>


        <a
            href="/admin/category/categories"
            class="<%= currentSideBar === 'categories' ? 'active' : '' %>">

            Categories

        </a>


        <a
            href="/admin/product/products"
            class="<%= currentSideBar === 'product' ? 'active' : '' %>">

            Products

        </a>


        <hr>


        <!-- ORDER MANAGEMENT -->

        <h6 class="text-muted">
            Order Management
        </h6>


        <a
            href="/admin/orders"
            class="<%= currentSideBar === 'orders' ? 'active' : '' %>">

            Orders

        </a>

        <a
    href="/admin/offers"
    class="<%= currentSideBar === 'offers' ? 'active' : '' %>">

    Offers

</a>

        <a
            href="/admin/coupons"
            class="<%= currentSideBar === 'coupons' ? 'active' : '' %>">

            Coupons

        </a>


        <hr>


        <!-- SALES REPORT -->

        <a
            href="/admin/salesReport"
            class="<%= currentSideBar === 'salesReport' ? 'active' : '' %>">

            Sales Report

        </a>


        <hr>


        <!-- LOGOUT -->

        <a
            href="/admin/logout"
            class="logout">

            Logout

        </a>

    </div>

</div>

    <div id="loader-container" class="loader-hidden">
        <div class="spinner"></div>
    </div>
        <!-- Main Content -->

        <div class="col-md-9">

            <div class="card shadow">

                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">

                    <h4 class="mb-0">
                        Add Variant
                    </h4>

                    <a
                        href="/admin/productVariant/<%= product._id %>"
                        class="btn btn-light">

                        Back

                    </a>

                </div>

                <div class="card-body">

                    <form
                        id="variantForm"
                        method="POST"
                        enctype="multipart/form-data">

                        <!-- Hidden Product ID -->

                        <input
                            type="hidden"
                            name="productId"
                            value="<%= product._id %>">

                        <!-- Product Name -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                Product Name

                            </label>

                            <input
                                type="text"
                                class="form-control"
                                value="<%= product.name %>"
                                readonly>

                        </div>
                        <small
                            class="text-danger"
                            id="ProductNameError">
                        </small>
                        <!-- Visibility -->

                        <div class="mb-3">

                            <label class="form-label">

                                Visibility

                            </label>

                            <select
                                name="list"
                                id="list"
                                class="form-select">

                                <option value="true">
                                    Active
                                </option>

                                <option value="false">
                                    Inactive
                                </option>

                            </select>

                        </div>

                        <!-- Color -->

                        <div class="mb-2">

                            <label class="form-label">

                                Color

                            </label>

                            <input
                                type="text"
                                id="color"
                                name="color"
                                class="form-control"
                                placeholder="Enter Color">

                        </div>
                         <small
                            class="text-danger"
                            id="colorError">
                        </small>

                        <!-- Regular Price -->

                        <div class="mb-3">

                            <label class="form-label">

                                Regular Price

                            </label>

                            <input
                                type="number"
                                id="regularPrice"
                                name="regularPrice"
                                class="form-control">

                         <small
                            class="text-danger"
                            id="regularPriceError">
                        </small>                                
                        </div>

                        <!-- Sale Price -->

                        <div class="mb-3">

                            <label class="form-label">

                                Sale Price

                            </label>

                            <input
                                type="number"
                                id="salePrice"
                                name="salePrice"
                                class="form-control">
                         <small
                            class="text-danger"
                            id="salePriceError">
                        </small>
                        </div>

                        <!-- Size Stock Section -->

                        <div class="mb-3">

                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <h5 class="mb-0">
                                    Size & Stock
                                </h5>
                        <small
                            class="text-danger"
                            id="sizeAndStockError">
                        </small>
                                <button
                                    type="button"
                                    id="addSizeBtn"
                                    class="btn btn-success btn-sm">

                                    + Add Size

                                </button>

                            </div>

                            <div id="sizeStockContainer">

                                <div class="row size-stock-row">

                                    <div class="col-md-5">

                                        <label class="form-label">
                                            Size
                                        </label>

                                        <input
                                            type="number"
                                            name="size[]"
                                            class="form-control sizeInput">

                                    </div>

                                    <div class="col-md-5">

                                        <label class="form-label">
                                            Stock
                                        </label>

                                        <input
                                            type="number"
                                            name="stock[]"
                                            class="form-control stockInput">

                                    </div>

                                    <div class="col-md-2 d-flex align-items-end">

                                        <button
                                            type="button"
                                            class="btn btn-danger removeSizeBtn">

                                            Remove

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Images -->

                        <div class="mb-3">

                            <label class="form-label">

                                Variant Images

                            </label>

                            <input
                                type="file"
                                id="images"
                                name="images"
                                class="form-control"
                                accept="image/*"
                                multiple>

                        </div>

                        <!-- Preview Area -->

                        <div
                            id="previewContainer"
                            class="d-flex flex-wrap mb-3">

                        </div>
                        <!-- Final Cropped Images Preview -->

                        <h5 class="mt-3">

                            Uploaded Image Preview

                        </h5>

                        <div
                            id="croppedPreviewContainer"
                            class="d-flex flex-wrap gap-2 mb-3">

                        </div>
                        <button
                            type="submit"
                            class="btn btn-primary">

                            Save Variant

                        </button>

                    </form>
                                    </div>

            </div>

        </div>

    </div>

</div>

<!-- Cropper Modal -->

<div
    class="modal fade"
    id="cropperModal"
    tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Crop Image
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body text-center">

                <img
                    id="cropperImage"
                    style="max-width:100%;">

            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                    Cancel

                </button>

                <button
                    type="button"
                    id="cropBtn"
                    class="btn btn-primary">

                    Crop

                </button>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

<script>

let cropper


const selectedImages = []
let imageId = 0

const cropperModal =new bootstrap.Modal(document.getElementById("cropperModal"))

const imageInput =document.getElementById("images")

const cropperImage =document.getElementById("cropperImage")

const previewContainer = document.getElementById("previewContainer")

const ProductNameError=document.getElementById("ProductNameError")
const colorError=document.getElementById("colorError")
const regularPriceError=document.getElementById("regularPriceError")
const salePriceError=document.getElementById("salePriceError")
const sizeAndStockError=document.getElementById("sizeAndStockError")

const loader=document.getElementById("loader-container")

function  showLoadingPage(){
loader.classList.remove("loader-hidden")
}

function hideLoadingPage(){
loader.classList.add("loader-hidden")
}

// IMAGE SELECTION
let imageQueue = []

imageInput.addEventListener("change", function (e) {

    const files = Array.from(e.target.files)

    if (selectedImages.length + imageQueue.length + files.length > 4){
         Swal.fire({
            icon: "error",
            title: "Maximum 4 images allowed"
        })
        return
    }

    imageQueue = files
    openNextImage()
})

function openNextImage() {

    if (imageQueue.length === 0) return

    const file = imageQueue.shift()

    const reader = new FileReader()

    // reader.onload = function (event) {

    //     cropperImage.src = event.target.result
    //     cropperModal.show()

    //     cropperModal._currentFile = file
    // }
    reader.onload = function (event) {
    cropperImage.onload = () => {
        cropperModal.show()
        cropperModal._currentFile = file
    }

    cropperImage.src = event.target.result
}
    reader.readAsDataURL(file)
}

// CROPPER OPEN

document.getElementById("cropperModal").addEventListener("shown.bs.modal", () => {
    if (cropper){ cropper.destroy()}

    cropper = new Cropper(cropperImage, {
        viewMode: 1,
        autoCropArea: 1,
        movable: true,
        zoomable: true,
        scalable: true,
        rotatable: true,
        aspectRatio: NaN
    })
})

// CROP BUTTON

document.getElementById("cropBtn").addEventListener("click", () => {

    const canvas = cropper.getCroppedCanvas()

    canvas.toBlob(blob => {

        const id = imageId++

        selectedImages.push({
            id,
            blob
        })

        const wrapper = document.createElement("div")
        wrapper.classList.add("position-relative", "m-1")
        wrapper.dataset.id = id

        const image = document.createElement("img")
        image.src = URL.createObjectURL(blob)
        image.classList.add("preview-image")

        const removeBtn = document.createElement("button")
        removeBtn.type = "button"
        removeBtn.innerHTML = "&times;"
        removeBtn.className =
            "btn btn-danger btn-sm position-absolute top-0 end-0"

        removeBtn.addEventListener("click", () => {

            const index = selectedImages.findIndex(img => img.id === id)

            if (index !== -1) selectedImages.splice(index, 1)

            wrapper.remove()
        })

        wrapper.appendChild(image)
        wrapper.appendChild(removeBtn)

        previewContainer.appendChild(wrapper)

        cropperModal.hide()

        openNextImage()

    }, "image/png")
})

// ADD SIZE

const addSizeBtn =document.getElementById("addSizeBtn")

const sizeStockContainer =document.getElementById("sizeStockContainer")

addSizeBtn.addEventListener("click",()=>{

    const row =document.createElement("div")

    row.className ="row size-stock-row"

    row.innerHTML = `

        <div class="col-md-5">

            <label class="form-label">
                Size
            </label>

            <input
                type="number"
                name="size[]"
                class="form-control sizeInput">

        </div>

        <div class="col-md-5">

            <label class="form-label">
                Stock
            </label>

            <input
                type="number"
                name="stock[]"
                class="form-control stockInput">

        </div>

        <div class="col-md-2 d-flex align-items-end">

            <button
                type="button"
                class="btn btn-danger removeSizeBtn">

                Remove

            </button>

        </div>

    `

    sizeStockContainer.appendChild(
        row
    )

}
)

// REMOVE SIZE OF THE sizeAndStock

document.addEventListener("click",function(e){

    if(e.target.classList.contains("removeSizeBtn")){

        const rows =document.querySelectorAll(".size-stock-row")

        if(rows.length > 1){
            e.target.closest(".size-stock-row").remove()
        }

    }

}
)

// FORM VALIDATION

document.getElementById("variantForm").addEventListener("submit",async function(e){
    console.log("Submit event triggered");
    let hasErrorInValidation=false
    e.preventDefault()

colorError.innerHTML=""
regularPriceError.innerHTML=""
salePriceError.innerHTML=""
sizeAndStockError.innerHTML=""
   

    const color =document.getElementById("color").value.trim()

    const regularPrice =Number(document.getElementById("regularPrice").value)

    const salePrice =Number(document.getElementById("salePrice").value)

    
    if(color === ""){
        hasErrorInValidation=true
colorError.innerText="Color is required"

    }

    if(!regularPrice || regularPrice <= 0){
        hasErrorInValidation=true
regularPriceError.innerHTML="Regular Price invalid"
    }

    if(!salePrice || salePrice <= 0){
    hasErrorInValidation=true
   salePriceError.innerHTML="Sale Price invalid"

    }

    if(salePrice > regularPrice){
    hasErrorInValidation=true
 salePriceError.innerHTML="Sale Price cannot exceed Regular Price"

    }

    const sizes =document.querySelectorAll(".sizeInput")

    const stocks =document.querySelectorAll(".stockInput")

    const sizeSet =new Set()

    for(let i=0;i<sizes.length;i++){

        const size =sizes[i].value
        const stock =stocks[i].value

        if( size === "" ||stock === ""){
            e.preventDefault()
sizeAndStockError.innerHTML="All Size and Stock fields are required"
        }

        if(sizeSet.has(size)){
        hasErrorInValidation=true
sizeAndStockError.innerHTML=`Size ${size} already added`
        }

        sizeSet.add(size)

    }

    
    if(selectedImages.length<3){
e.preventDefault()
hasErrorInValidation=true
        return Swal.fire({
                icon:"error",
                title:"Minimum of 3 images required"
            })
    }

        if(hasErrorInValidation){
        return e.preventDefault()
    }
    const form = document.getElementById("variantForm")

   const formData = new FormData(form)

formData.delete("images")

console.log("FINAL SELECTED IMAGES:", selectedImages)
selectedImages.forEach(item => {
    formData.append("images",item.blob,`cropped-${item.id}.png`)
})

showLoadingPage()
const response = await fetch("/admin/addProductVariant", {
    method: "POST",
    body: formData
})
const data = await response.json()

console.log("Response from backend:", data)

if(data.success){
    console.log("got response from frontend .now isnide data sucess ")
    console.log("response "+data.success)
    window.location.href = `/admin/productVariant/${data.productId}`
}
else{
    hideLoadingPage()
    Swal.fire({
        icon:"error",
        title:data.errorMsg
    })
}

})


</script>

</body>

</html>