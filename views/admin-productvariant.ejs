<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Product Variants</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">


    <style>

        body {

            background-color: #f5f6f8;

            margin: 0;

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;

        }


        /* =========================================
           SIDEBAR
        ========================================= */

        .sidebar {

            background-color: #ffffff;

            min-height: 100vh;

            padding: 25px 18px;

            border-right: 1px solid #e5e7eb;

            position: sticky;

            top: 0;

        }


        .sidebar-title {

            font-size: 21px;

            font-weight: 700;

            margin-bottom: 30px;

            padding-left: 10px;

        }


        .sidebar-section {

            font-size: 11px;

            font-weight: 700;

            color: #8a8f98;

            text-transform: uppercase;

            margin-top: 20px;

            margin-bottom: 8px;

            padding-left: 10px;

        }


        .sidebar a {

            display: flex;

            align-items: center;

            gap: 10px;

            text-decoration: none;

            color: #555b65;

            padding: 11px 12px;

            margin-bottom: 4px;

            border-radius: 8px;

            font-size: 14px;

            transition: 0.2s;

        }


        .sidebar a:hover {

            background-color: #f1f3f5;

            color: #212529;

        }


        .sidebar a.active {

            background-color: #212529;

            color: #ffffff;

        }


        .sidebar hr {

            border: 0;

            border-top: 1px solid #eeeeee;

            margin: 20px 0;

        }


        /* =========================================
           MAIN CONTENT
        ========================================= */

        .main-content {

            padding: 30px;

        }


        /* =========================================
           CARD
        ========================================= */

        .variant-card {

            border: none;

            border-radius: 15px;

        }


        .variant-card .card-header {

            border-radius: 15px 15px 0 0;

        }


        /* =========================================
           MOBILE
        ========================================= */

        @media (max-width: 767px) {

            .sidebar {

                min-height: auto;

                position: relative;

                border-right: none;

                border-bottom: 1px solid #e5e7eb;

            }


            .main-content {

                padding: 20px 15px;

            }

        }

    </style>

</head>


<body>


<div class="container-fluid">

    <div class="row">


        <!-- =========================================
             SIDEBAR
        ========================================= -->

        <div class="col-md-3 col-lg-2 p-0">

            <div class="sidebar">


                <div class="sidebar-title">

                    Admin Panel

                </div>


                <!-- =================================
                     MANAGEMENT
                ================================== -->

                <div class="sidebar-section">

                    Management

                </div>


                <a
                    href="/admin/userManagement"
                    class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>">

                    <i class="bi bi-people"></i>

                    Users

                </a>


                <hr>


                <!-- =================================
                     CATALOG
                ================================== -->

                <div class="sidebar-section">

                    Catalog Management

                </div>


                <a
                    href="/admin/category/categories"
                    class="<%= currentSideBar === 'categories' ? 'active' : '' %>">

                    <i class="bi bi-tags"></i>

                    Categories

                </a>


                <a
                    href="/admin/product/products"
                    class="<%= currentSideBar === 'product' ? 'active' : '' %>">

                    <i class="bi bi-box-seam"></i>

                    Products

                </a>


                <!-- Variants -->

                <a
                    href="#"
                    class="<%= currentSideBar === 'variant' ? 'active' : '' %>">

                    <i class="bi bi-layers"></i>

                    Variants

                </a>


                <hr>


                <!-- =================================
                     ORDER MANAGEMENT
                ================================== -->

                <div class="sidebar-section">

                    Order Management

                </div>


                <a
                    href="/admin/orders"
                    class="<%= currentSideBar === 'orders' ? 'active' : '' %>">

                    <i class="bi bi-cart-check"></i>

                    Orders

                </a>


                <a
                    href="/admin/coupons"
                    class="<%= currentSideBar === 'coupons' ? 'active' : '' %>">

                    <i class="bi bi-ticket-perforated"></i>

                    Coupons

                </a>


                <a
                    href="/admin/offers/list"
                    class="<%= currentSideBar === 'offers' ? 'active' : '' %>">

                    <i class="bi bi-percent"></i>

                    Offers

                </a>


                <hr>


                <!-- =================================
                     REPORTS
                ================================== -->

                <div class="sidebar-section">

                    Reports

                </div>


                <a
                    href="/admin/sales-report"
                    class="<%= currentSideBar === 'salesReport' ? 'active' : '' %>">

                    <i class="bi bi-bar-chart-line"></i>

                    Sales Report

                </a>


                <hr>


                <!-- =================================
                     LOGOUT
                ================================== -->

                <a
                    href="/admin/logout"
                    class="text-danger fw-bold">

                    <i class="bi bi-box-arrow-right"></i>

                    Logout

                </a>


            </div>

        </div>



        <!-- =========================================
             MAIN CONTENT
        ========================================= -->

        <div class="col-md-9 col-lg-10">

            <div class="main-content">


                <div class="card shadow-sm variant-card">


                    <!-- =================================
                         CARD HEADER
                    ================================== -->

                    <div
                        class="card-header bg-dark text-white d-flex justify-content-between align-items-center flex-wrap gap-2">


                        <div>

                            <h4 class="mb-0">

                                Variants - <%= product.name %>

                            </h4>

                        </div>


                        <a
                            href="/admin/addproductVariant/<%= product._id %>"
                            class="btn btn-primary">

                            <i class="bi bi-plus-lg"></i>

                            Add Variant

                        </a>


                    </div>



                    <!-- =================================
                         CARD BODY
                    ================================== -->

                    <div class="card-body">


                        <!-- Search + Sort -->

                        <div class="row g-3 mb-4">


                            <div class="col-md-5">

                                <input
                                    id="searchInput"
                                    type="text"
                                    class="form-control"
                                    placeholder="Search Color">

                            </div>


                            <div class="col-md-2">

                                <button
                                    id="searchBtn"
                                    class="btn btn-success w-100">

                                    <i class="bi bi-search"></i>

                                    Search

                                </button>

                            </div>


                            <div class="col-md-2">

                                <button
                                    id="clearBtn"
                                    class="btn btn-secondary w-100">

                                    Clear

                                </button>

                            </div>


                            <div class="col-md-3">

                                <select
                                    id="sortSelect"
                                    class="form-select">

                                    <option selected>

                                        Sort By

                                    </option>


                                    <option>

                                        Newest First

                                    </option>


                                    <option>

                                        Oldest First

                                    </option>


                                    <option>

                                        A - Z

                                    </option>


                                    <option>

                                        Z - A

                                    </option>

                                </select>

                            </div>


                        </div>



                        <!-- =================================
                             TABLE
                        ================================== -->

                        <div class="table-responsive">


                            <table
                                class="table table-hover align-middle">


                                <thead class="table-dark">

                                    <tr>

                                        <th>
                                            Color
                                        </th>

                                        <th>
                                            Sale Price
                                        </th>

                                        <th>
                                            Regular Price
                                        </th>

                                        <th>
                                            Sizes & Stock
                                        </th>

                                        <th>
                                            Status
                                        </th>

                                        <th>
                                            Actions
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>


                                <% variants.forEach(variant => { %>


                                    <tr>


                                        <!-- COLOR -->

                                        <td>

                                            <strong>

                                                <%= variant.color %>

                                            </strong>

                                        </td>


                                        <!-- SALE PRICE -->

                                        <td>

                                            ₹<%= variant.salePrice %>

                                        </td>


                                        <!-- REGULAR PRICE -->

                                        <td>

                                            ₹<%= variant.regularPrice %>

                                        </td>


                                        <!-- SIZE & STOCK -->

                                        <td>


                                            <% variant.sizeAndStock.forEach(item => { %>


                                                <span
                                                    class="badge bg-secondary me-1">

                                                    <%= item.size %>

                                                    (<%= item.stock %>)

                                                </span>


                                            <% }) %>


                                        </td>


                                        <!-- STATUS -->

                                        <td>


                                            <% if(variant.list){ %>


                                                <span
                                                    class="badge bg-success">

                                                    Active

                                                </span>


                                            <% }else{ %>


                                                <span
                                                    class="badge bg-danger">

                                                    Inactive

                                                </span>


                                            <% } %>


                                        </td>


                                        <!-- ACTIONS -->

                                        <td>


                                            <a
                                                href="/admin/editExistingProductVarient/<%=variant._id%>"
                                                class="btn btn-warning btn-sm me-2">

                                                <i class="bi bi-pencil"></i>

                                                Edit

                                            </a>


                                            <% if(variant.list){ %>


                                                <form
                                                    action="/admin/deactivateExistingProductVarient/<%= variant._id %>"
                                                    method="POST"
                                                    style="display:inline;">


                                                    <button
                                                        class="btn btn-danger btn-sm">

                                                        <i class="bi bi-x-circle"></i>

                                                        Deactivate

                                                    </button>


                                                </form>


                                            <% }else{ %>


                                                <form
                                                    action="/admin/activateExistingProductVarient/<%= variant._id %>"
                                                    method="POST"
                                                    style="display:inline;">


                                                    <button
                                                        class="btn btn-success btn-sm">

                                                        <i class="bi bi-check-circle"></i>

                                                        Activate

                                                    </button>


                                                </form>


                                            <% } %>


                                        </td>


                                    </tr>


                                <% }) %>


                                </tbody>


                            </table>


                        </div>



                        <!-- =================================
                             PAGINATION
                        ================================== -->

                        <nav>

                            <ul class="pagination justify-content-center mt-4">


                                <% if(currentPage > 1){ %>


                                    <li class="page-item">


                                        <a
                                            class="page-link"
                                            href="?page=<%= currentPage-1 %>">

                                            Previous

                                        </a>


                                    </li>


                                <% } %>



                                <% for(let i=1;i<=totalPages;i++){ %>


                                    <li
                                        class="page-item <%= i===currentPage ? 'active' : '' %>">


                                        <a
                                            class="page-link"
                                            href="?page=<%= i %>">

                                            <%= i %>

                                        </a>


                                    </li>


                                <% } %>



                                <% if(currentPage < totalPages){ %>


                                    <li class="page-item">


                                        <a
                                            class="page-link"
                                            href="?page=<%= currentPage+1 %>">

                                            Next

                                        </a>


                                    </li>


                                <% } %>


                            </ul>

                        </nav>


                    </div>

                </div>


            </div>

        </div>


    </div>

</div>


</body>

</html>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

const searchInput =
document.getElementById("searchInput")

const searchBtn =
document.getElementById("searchBtn")

const clearBtn =
document.getElementById("clearBtn")

searchBtn.addEventListener("click",()=>{

    const searchValue =searchInput.value.trim()

    if(searchValue !== ""){

        const url =
        new URL(window.location.href)

        url.searchParams.set(
            "search",
            searchValue
        )

        window.location.href =
        url.href

    }

})

clearBtn.addEventListener("click",()=>{

    const url =
    new URL(window.location.href)

    url.searchParams.delete("search")

    window.location.href =
    url.pathname

})

const sortSelect =
document.getElementById("sortSelect")

sortSelect.addEventListener("change",()=>{

    const url =
    new URL(window.location.href)

    url.searchParams.set(
        "sort",
        sortSelect.value
    )

    window.location.href =
    url.href

})

const alertData =
<%- JSON.stringify(alert || null) %>

if(alertData){

    Swal.fire({

        icon:alertData.type,
        title:alertData.message,
        confirmButtonText:"OK"

    })

}

</script>

</body>
</html>