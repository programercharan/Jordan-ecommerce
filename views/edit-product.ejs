<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Edit Product</title>


<!-- Bootstrap -->

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet">


<!-- Bootstrap Icons -->

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">


<style>

    body {

        background-color: #f5f6f8;

        margin: 0;

        font-family:
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            Arial,
            sans-serif;

    }


    /* ==============================
       SIDEBAR
    ============================== */

    .sidebar {

        background-color: #ffffff;

        min-height: 100vh;

        padding: 25px 18px;

        border-right: 1px solid #e5e7eb;

        position: sticky;

        top: 0;

    }


    .sidebar-title {

        font-size: 21px;

        font-weight: 700;

        margin-bottom: 30px;

        padding-left: 10px;

    }


    .sidebar-section {

        font-size: 11px;

        font-weight: 700;

        color: #8a8f98;

        text-transform: uppercase;

        margin-top: 20px;

        margin-bottom: 8px;

        padding-left: 10px;

    }


    .sidebar a {

        display: flex;

        align-items: center;

        gap: 10px;

        text-decoration: none;

        color: #555b65;

        padding: 11px 12px;

        margin-bottom: 4px;

        border-radius: 8px;

        font-size: 14px;

        transition: 0.2s;

    }


    .sidebar a:hover {

        background-color: #f1f3f5;

        color: #212529;

    }


    .sidebar a.active {

        background-color: #212529;

        color: #ffffff;

    }


    .sidebar hr {

        border: 0;

        border-top: 1px solid #eeeeee;

        margin: 20px 0;

    }


    /* ==============================
       MAIN CONTENT
    ============================== */

    .main-content {

        padding: 30px;

    }


    .edit-card {

        border: none;

        border-radius: 15px;

    }


    /* ==============================
       MOBILE
    ============================== */

    @media (max-width: 767px) {

        .sidebar {

            min-height: auto;

            position: relative;

            border-right: none;

            border-bottom: 1px solid #e5e7eb;

        }


        .main-content {

            padding: 20px 15px;

        }

    }

</style>


</head>

<body>

<div class="container-fluid">


<div class="row">


    <!-- ==========================================
         SIDEBAR
    =========================================== -->

    <div class="col-md-3 col-lg-2 p-0">

        <div class="sidebar">


            <div class="sidebar-title">

                Admin Panel

            </div>


            <!-- MANAGEMENT -->

            <div class="sidebar-section">

                Management

            </div>


            <a
                href="/admin/dashboard"
                class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>">

                <i class="bi bi-people"></i>

                Users

            </a>


            <hr>


            <!-- CATALOG -->

            <div class="sidebar-section">

                Catalog Management

            </div>


            <a
                href="/admin/category/categories"
                class="<%= currentSideBar === 'categories' ? 'active' : '' %>">

                <i class="bi bi-tags"></i>

                Categories

            </a>


            <a
                href="/admin/product/products"
                class="<%= currentSideBar === 'products' ? 'active' : '' %>">

                <i class="bi bi-box-seam"></i>

                Products

            </a>


            <hr>


            <!-- ORDER MANAGEMENT -->

            <div class="sidebar-section">

                Order Management

            </div>


            <a
                href="/admin/orders"
                class="<%= currentSideBar === 'orders' ? 'active' : '' %>">

                <i class="bi bi-cart-check"></i>

                Orders

            </a>


            <a
                href="/admin/coupons"
                class="<%= currentSideBar === 'coupons' ? 'active' : '' %>">

                <i class="bi bi-ticket-perforated"></i>

                Coupons

            </a>


            <a
                href="/admin/offers/list"
                class="<%= currentSideBar === 'offers' ? 'active' : '' %>">

                <i class="bi bi-percent"></i>

                Offers

            </a>


            <hr>


            <!-- REPORTS -->

            <div class="sidebar-section">

                Reports

            </div>


            <a
                href="/admin/sales-report"
                class="<%= currentSideBar === 'salesReport' ? 'active' : '' %>">

                <i class="bi bi-bar-chart-line"></i>

                Sales Report

            </a>


            <hr>


            <!-- LOGOUT -->

            <a
                href="/admin/logout"
                class="text-danger fw-bold">

                <i class="bi bi-box-arrow-right"></i>

                Logout

            </a>


        </div>

    </div>



    <!-- ==========================================
         MAIN CONTENT
    =========================================== -->

    <div class="col-md-9 col-lg-10">


        <div class="main-content">


            <div class="card edit-card shadow-sm">


                <!-- HEADER -->

                <div class="card-header bg-dark text-white">

                    <h4 class="mb-0">

                        Edit Product

                    </h4>

                </div>



                <div class="card-body p-4">


                    <form
                        id="edit-product"
                        action="/admin/product/editProduct/<%= product._id %>"
                        method="POST">


                        <p
                            class="text-danger"
                            id="credentialError">
                        </p>



                        <!-- ==========================
                             CATEGORY
                        =========================== -->

                        <div class="mb-3">

                            <label class="form-label">

                                Category

                            </label>


                            <select
                                id="categoryId"
                                name="categoryId"
                                class="form-select">


                                <option value="">

                                    Select Category

                                </option>


                                <% categories.forEach(category=>{ %>


                                    <option
                                        value="<%= category._id %>"
                                        <%= String(product.categoryId) === String(category._id) ? "selected" : "" %>>


                                        <%= category.categoryName %>


                                    </option>


                                <% }) %>


                            </select>


                            <small
                                class="text-danger"
                                id="categoryError">
                            </small>


                        </div>



                        <!-- ==========================
                             PRODUCT NAME
                        =========================== -->

                        <div class="mb-3">

                            <label class="form-label">

                                Product Name

                            </label>


                            <input
                                type="text"
                                id="name"
                                name="name"
                                class="form-control"
                                value="<%= product.name %>">


                            <small
                                class="text-danger"
                                id="nameError">
                            </small>


                        </div>



                        <!-- ==========================
                             DESCRIPTION
                        =========================== -->

                        <div class="mb-3">

                            <label class="form-label">

                                Description

                            </label>


                            <textarea
                                id="description"
                                name="description"
                                class="form-control"
                                rows="4"><%= product.description %></textarea>


                            <small
                                class="text-danger"
                                id="descriptionError">
                            </small>


                        </div>



                        <!-- ==========================
                             BRAND
                        =========================== -->

                        <div class="mb-3">

                            <label class="form-label">

                                Brand

                            </label>


                            <input
                                type="text"
                                id="brand"
                                name="brand"
                                class="form-control"
                                value="<%= product.brand %>">


                            <small
                                class="text-danger"
                                id="brandError">
                            </small>


                        </div>



                        <!-- ==========================
                             GENDER
                        =========================== -->

                        <div class="mb-3">

                            <label class="form-label">

                                Gender

                            </label>


                            <select
                                id="gender"
                                name="gender"
                                class="form-select">


                                <option value="">

                                    Select Gender

                                </option>


                                <option
                                    value="men"
                                    <%= product.gender==="men" ? "selected" : "" %>>

                                    Men

                                </option>


                                <option
                                    value="women"
                                    <%= product.gender==="women" ? "selected" : "" %>>

                                    Women

                                </option>


                                <option
                                    value="kids"
                                    <%= product.gender==="kids" ? "selected" : "" %>>

                                    Kids

                                </option>


                                <option
                                    value="unisex"
                                    <%= product.gender==="unisex" ? "selected" : "" %>>

                                    Unisex

                                </option>


                            </select>


                            <small
                                class="text-danger"
                                id="genderError">
                            </small>


                        </div>



                        <!-- ==========================
                             STOCK STATUS
                        =========================== -->

                        <div class="mb-3">

                            <label class="form-label">

                                Stock Status

                            </label>


                            <select
                                id="stockStatus"
                                name="stockStatus"
                                class="form-select">


                                <option value="">

                                    Select Stock Status

                                </option>


                                <option
                                    value="inStock"
                                    <%= product.stockStatus==="inStock" ? "selected" : "" %>>

                                    In Stock

                                </option>


                                <option
                                    value="outOfStock"
                                    <%= product.stockStatus==="outOfStock" ? "selected" : "" %>>

                                    Out Of Stock

                                </option>


                            </select>


                            <small
                                class="text-danger"
                                id="stockError">
                            </small>


                        </div>



                        <!-- ==========================
                             PRODUCT VISIBILITY
                        =========================== -->

                        <div class="mb-3">

                            <label class="form-label">

                                Product Visibility

                            </label>


                            <select
                                id="list"
                                name="list"
                                class="form-select">


                                <option
                                    value="true"
                                    <%= product.list ? "selected" : "" %>>

                                    Listed

                                </option>


                                <option
                                    value="false"
                                    <%= !product.list ? "selected" : "" %>>

                                    Unlisted

                                </option>


                            </select>


                            <small
                                class="text-danger"
                                id="listError">
                            </small>


                        </div>



                        <!-- ==========================
                             BUTTON
                        =========================== -->

                        <div class="d-flex justify-content-end">

                            <button
                                type="submit"
                                class="btn btn-primary px-4">

                                Update Product

                            </button>

                        </div>


                    </form>


                </div>


            </div>


        </div>


    </div>


</div>


</div>

</body>

</html>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

const form=document.getElementById("edit-product")

form.addEventListener("submit",(e)=>{

    e.preventDefault()

    let hasError=false

    const categoryId=document.getElementById("categoryId").value
    const name=document.getElementById("name").value.trim()
    const description=document.getElementById("description").value.trim()
    const brand=document.getElementById("brand").value.trim()
    const gender=document.getElementById("gender").value
    const stockStatus=document.getElementById("stockStatus").value
    const list=document.getElementById("list").value

    document.getElementById("credentialError").innerText=""
    document.getElementById("categoryError").innerText=""
    document.getElementById("nameError").innerText=""
    document.getElementById("descriptionError").innerText=""
    document.getElementById("brandError").innerText=""
    document.getElementById("genderError").innerText=""
    document.getElementById("stockError").innerText=""
    document.getElementById("listError").innerText=""

    if(
        categoryId==="" &&
        name==="" &&
        description==="" &&
        brand==="" &&
        gender==="" &&
        stockStatus===""
    ){
        document.getElementById("credentialError").innerText =
        "All Fields Are Required"

        hasError=true
    }

    if(categoryId===""){
        document.getElementById("categoryError").innerText =
        "Select Category"
        hasError=true
    }

    if(name===""){
        document.getElementById("nameError").innerText =
        "Enter Product Name"
        hasError=true
    }

    if(description===""){
        document.getElementById("descriptionError").innerText =
        "Enter Description"
        hasError=true
    }

    if(brand===""){
        document.getElementById("brandError").innerText =
        "Enter Brand Name"
        hasError=true
    }

    if(gender===""){
        document.getElementById("genderError").innerText =
        "Select Gender"
        hasError=true
    }

    if(stockStatus===""){
        document.getElementById("stockError").innerText =
        "Select Stock Status"
        hasError=true
    }

    if(list===""){
        document.getElementById("listError").innerText =
        "Select Product Visibility"
        hasError=true
    }

    if(!hasError){
        form.submit()
    }

})

</script>

</body>
</html>
<script>
    const alertData=<%-JSON.stringify(alert||null)%>
    if(alertData){
        Swal.fire({
            icon:alertData.type,
            title:alertData.message
        })
    }
    
</script>