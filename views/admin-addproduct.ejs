<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Add Product</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">


    <style>

        body {

            background-color: #f5f6f8;

            margin: 0;

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;

        }


        /* ==============================
           SIDEBAR
        ============================== */

        .sidebar {

            background-color: #ffffff;

            min-height: 100vh;

            padding: 25px 18px;

            border-right: 1px solid #e5e7eb;

            position: sticky;

            top: 0;

        }


        .sidebar-title {

            font-size: 21px;

            font-weight: 700;

            margin-bottom: 30px;

            padding-left: 10px;

        }


        .sidebar-section {

            font-size: 11px;

            font-weight: 700;

            color: #8a8f98;

            text-transform: uppercase;

            margin-top: 20px;

            margin-bottom: 8px;

            padding-left: 10px;

        }


        .sidebar a {

            display: flex;

            align-items: center;

            gap: 10px;

            text-decoration: none;

            color: #555b65;

            padding: 11px 12px;

            margin-bottom: 4px;

            border-radius: 8px;

            font-size: 14px;

            transition: 0.2s;

        }


        .sidebar a:hover {

            background-color: #f1f3f5;

            color: #212529;

        }


        .sidebar a.active {

            background-color: #212529;

            color: #ffffff;

        }


        .sidebar hr {

            border: 0;

            border-top: 1px solid #eeeeee;

            margin: 20px 0;

        }


        /* ==============================
           MAIN CONTENT
        ============================== */

        .main-content {

            padding: 30px;

        }


        /* ==============================
           PRODUCT CARD
        ============================== */

        .product-card {

            border: none;

            border-radius: 15px;

        }


        .product-card .card-header {

            border-radius: 15px 15px 0 0;

            padding: 18px 22px;

        }


        /* ==============================
           MOBILE
        ============================== */

        @media (max-width: 767px) {

            .sidebar {

                min-height: auto;

                position: relative;

                border-right: none;

                border-bottom: 1px solid #e5e7eb;

            }


            .main-content {

                padding: 20px 15px;

            }

        }

    </style>

</head>


<body>


<div class="container-fluid">

    <div class="row">


        <!-- ==========================================
             SIDEBAR
        =========================================== -->

        <div class="col-md-3 col-lg-2 p-0">

            <div class="sidebar">


                <div class="sidebar-title">

                    Admin Panel

                </div>


                <!-- MANAGEMENT -->

                <div class="sidebar-section">

                    Management

                </div>


                <a
                    href="/admin/userManagement"
                    class="<%= currentSideBar === 'users' ? 'active' : '' %>">

                    <i class="bi bi-people"></i>

                    Users

                </a>


                <hr>


                <!-- CATALOG MANAGEMENT -->

                <div class="sidebar-section">

                    Catalog Management

                </div>


                <a
                    href="/admin/category/categories"
                    class="<%= currentSideBar === 'categories' ? 'active' : '' %>">

                    <i class="bi bi-tags"></i>

                    Categories

                </a>


                <a
                    href="/admin/product/products"
                    class="<%= currentSideBar === 'products' ? 'active' : '' %>">

                    <i class="bi bi-box-seam"></i>

                    Products

                </a>


                <!--
                <a
                    href="/admin/variant/variants"
                    class="<%= currentSideBar === 'variants' ? 'active' : '' %>">

                    <i class="bi bi-grid"></i>

                    Variants

                </a>
                -->


                <hr>


                <!-- ORDER MANAGEMENT -->

                <div class="sidebar-section">

                    Order Management

                </div>


                <a
                    href="/admin/orders"
                    class="<%= currentSideBar === 'orders' ? 'active' : '' %>">

                    <i class="bi bi-cart-check"></i>

                    Orders

                </a>


                <a
                    href="/admin/coupons"
                    class="<%= currentSideBar === 'coupons' ? 'active' : '' %>">

                    <i class="bi bi-ticket-perforated"></i>

                    Coupons

                </a>


                <a
                    href="/admin/offers/list"
                    class="<%= currentSideBar === 'offers' ? 'active' : '' %>">

                    <i class="bi bi-percent"></i>

                    Offers

                </a>


                <hr>


                <!-- REPORTS -->

                <div class="sidebar-section">

                    Reports

                </div>


                <a
                    href="/admin/sales-report"
                    class="<%= currentSideBar === 'salesReport' ? 'active' : '' %>">

                    <i class="bi bi-bar-chart-line"></i>

                    Sales Report

                </a>


                <hr>


                <!-- LOGOUT -->

                <a
                    href="/admin/logout"
                    class="text-danger fw-bold">

                    <i class="bi bi-box-arrow-right"></i>

                    Logout

                </a>


            </div>

        </div>



        <!-- ==========================================
             MAIN CONTENT
        =========================================== -->

        <div class="col-md-9 col-lg-10 main-content">


            <div class="card shadow-sm product-card">


                <div class="card-header bg-dark text-white">

                    <h4 class="mb-0">

                        Add Product

                    </h4>

                </div>


                <div class="card-body p-4">


                    <form
                        id="add-product"
                        action="/admin/product/addProduct"
                        method="POST">


                        <p
                            class="text-danger"
                            id="credentialError">
                        </p>



                        <!-- CATEGORY -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                Category

                            </label>


                            <select
                                id="categoryId"
                                name="categoryId"
                                class="form-select">


                                <option value="">

                                    Select Category

                                </option>


                                <% categories.forEach(category => { %>

                                    <option
                                        value="<%= category._id %>">

                                        <%= category.categoryName %>

                                    </option>

                                <% }) %>


                            </select>


                            <small
                                class="text-danger"
                                id="categoryError">
                            </small>

                        </div>



                        <!-- PRODUCT NAME -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                Product Name

                            </label>


                            <input
                                type="text"
                                id="name"
                                name="name"
                                class="form-control"
                                placeholder="Enter Product Name">


                            <small
                                class="text-danger"
                                id="nameError">
                            </small>

                        </div>



                        <!-- DESCRIPTION -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                Description

                            </label>


                            <textarea
                                id="description"
                                name="description"
                                rows="4"
                                class="form-control"
                                placeholder="Enter Description"></textarea>


                            <small
                                class="text-danger"
                                id="descriptionError">
                            </small>

                        </div>



                        <!-- BRAND -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                Brand

                            </label>


                            <input
                                type="text"
                                id="brand"
                                name="brand"
                                class="form-control"
                                placeholder="Enter Brand Name">


                            <small
                                class="text-danger"
                                id="brandError">
                            </small>

                        </div>



                        <!-- GENDER -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                Gender

                            </label>


                            <select
                                id="gender"
                                name="gender"
                                class="form-select">


                                <option value="">

                                    Select Gender

                                </option>


                                <option value="men">

                                    Men

                                </option>


                                <option value="women">

                                    Women

                                </option>


                                <option value="kids">

                                    Kids

                                </option>


                                <option value="unisex">

                                    Unisex

                                </option>


                            </select>


                            <small
                                class="text-danger"
                                id="genderError">
                            </small>

                        </div>



                        <!-- STOCK STATUS -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                Stock Status

                            </label>


                            <select
                                id="stockStatus"
                                name="stockStatus"
                                class="form-select">


                                <option value="">

                                    Select Stock Status

                                </option>


                                <option value="inStock">

                                    In Stock

                                </option>


                                <option value="outOfStock">

                                    Out Of Stock

                                </option>


                            </select>


                            <small
                                class="text-danger"
                                id="stockStatusError">
                            </small>

                        </div>



                        <!-- VISIBILITY -->

                        <div class="mb-3">

                            <label class="form-label fw-semibold">

                                Visibility

                            </label>


                            <select
                                id="list"
                                name="list"
                                class="form-select">


                                <option value="">

                                    Select Visibility

                                </option>


                                <option value="true">

                                    Listed

                                </option>


                                <option value="false">

                                    Unlisted

                                </option>


                            </select>


                            <small
                                class="text-danger"
                                id="listError">
                            </small>

                        </div>



                        <!-- BUTTON -->

                        <div class="d-flex justify-content-end mt-4">


                            <button
                                type="submit"
                                class="btn btn-dark px-4">

                                Add Product

                            </button>


                        </div>


                    </form>


                </div>

            </div>


        </div>

    </div>

</div>


</body>

</html>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<script>

const form =
document.getElementById("add-product")

form.addEventListener("submit", (e) => {

    e.preventDefault()

    let hasError = false

    const categoryId =
    document.getElementById("categoryId").value

    const name =
    document.getElementById("name").value.trim()

    const description =
    document.getElementById("description").value.trim()

    const brand =
    document.getElementById("brand").value.trim()

    const gender =
    document.getElementById("gender").value

    const stockStatus =
    document.getElementById("stockStatus").value

    const list =
    document.getElementById("list").value


    const categoryError =
    document.getElementById("categoryError")

    const nameError =
    document.getElementById("nameError")

    const descriptionError =
    document.getElementById("descriptionError")

    const brandError =
    document.getElementById("brandError")

    const genderError =
    document.getElementById("genderError")

    const stockStatusError =
    document.getElementById("stockStatusError")

    const listError =
    document.getElementById("listError")

    const credentialError =
    document.getElementById("credentialError")


    // Clear old errors

    categoryError.innerText = ""
    nameError.innerText = ""
    descriptionError.innerText = ""
    brandError.innerText = ""
    genderError.innerText = ""
    stockStatusError.innerText = ""
    listError.innerText = ""
    credentialError.innerText = ""


    // Check whether all fields are empty

    if (
        categoryId === "" &&
        name === "" &&
        description === "" &&
        brand === "" &&
        gender === "" &&
        stockStatus === "" &&
        list === ""
    ) {

        credentialError.innerText =
        "All Fields Are Required"

        hasError = true
    }


    // Category validation

    if (categoryId === "") {

        categoryError.innerText =
        "Select Category"

        hasError = true
    }


    // Name validation

    if (name === "") {

        nameError.innerText =
        "Enter Product Name"

        hasError = true
    }


    // Description validation

    if (description === "") {

        descriptionError.innerText =
        "Enter Description"

        hasError = true
    }


    // Brand validation

    if (brand === "") {

        brandError.innerText =
        "Enter Brand Name"

        hasError = true
    }


    // Gender validation

    if (gender === "") {

        genderError.innerText =
        "Select Gender"

        hasError = true
    }


    // Stock status validation

    if (stockStatus === "") {

        stockStatusError.innerText =
        "Select Stock Status"

        hasError = true
    }


    // Visibility validation

    if (list === "") {

        listError.innerText =
        "Select Visibility"

        hasError = true
    }


    // Submit only if there is no error

    if (!hasError) {

        form.submit()

    }

})


// ==========================================
// DYNAMIC ERROR REMOVAL
// ==========================================


// Product Name

document.getElementById("name").addEventListener("input", () => {

    const value =
    document.getElementById("name").value.trim()

    if (value !== "") {

        document.getElementById("nameError").innerText = ""

        document.getElementById("credentialError").innerText = ""

    }

})


// Description

document.getElementById("description").addEventListener("input", () => {

    const value =
    document.getElementById("description").value.trim()

    if (value !== "") {

        document.getElementById("descriptionError").innerText = ""

        document.getElementById("credentialError").innerText = ""

    }

})


// Brand

document.getElementById("brand").addEventListener("input", () => {

    const value =
    document.getElementById("brand").value.trim()

    if (value !== "") {

        document.getElementById("brandError").innerText = ""

        document.getElementById("credentialError").innerText = ""

    }

})


// Category

document.getElementById("categoryId").addEventListener("change", () => {

    const value =
    document.getElementById("categoryId").value

    if (value !== "") {

        document.getElementById("categoryError").innerText = ""

        document.getElementById("credentialError").innerText = ""

    }

})


// Gender

document.getElementById("gender").addEventListener("change", () => {

    const value =
    document.getElementById("gender").value

    if (value !== "") {

        document.getElementById("genderError").innerText = ""

        document.getElementById("credentialError").innerText = ""

    }

})


// Stock Status

document.getElementById("stockStatus").addEventListener("change", () => {

    const value =
    document.getElementById("stockStatus").value

    if (value !== "") {

        document.getElementById("stockStatusError").innerText = ""

        document.getElementById("credentialError").innerText = ""

    }

})


// Visibility

document.getElementById("list").addEventListener("change", () => {

    const value =
    document.getElementById("list").value

    if (value !== "") {

        document.getElementById("listError").innerText = ""

        document.getElementById("credentialError").innerText = ""

    }

})

</script>


