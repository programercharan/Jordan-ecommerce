```html
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">


    <!-- Chart.js -->

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <style>

        body {
            background-color: #f5f6f8;
            margin: 0;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;
        }


        /* ==============================
           SIDEBAR
        ============================== */

        .sidebar {

            background-color: #ffffff;

            min-height: 100vh;

            padding: 25px 18px;

            border-right: 1px solid #e5e7eb;

            position: sticky;

            top: 0;
        }


        .sidebar-title {

            font-size: 21px;

            font-weight: 700;

            margin-bottom: 30px;

            padding-left: 10px;
        }


        .sidebar-section {

            font-size: 11px;

            font-weight: 700;

            color: #8a8f98;

            text-transform: uppercase;

            margin-top: 20px;

            margin-bottom: 8px;

            padding-left: 10px;
        }


        .sidebar a {

            display: flex;

            align-items: center;

            gap: 10px;

            text-decoration: none;

            color: #555b65;

            padding: 11px 12px;

            margin-bottom: 4px;

            border-radius: 8px;

            font-size: 14px;

            transition: 0.2s;
        }


        .sidebar a:hover {

            background-color: #f1f3f5;

            color: #212529;
        }


        .sidebar a.active {

            background-color: #212529;

            color: #ffffff;
        }


        .sidebar hr {

            border: 0;

            border-top: 1px solid #eeeeee;

            margin: 20px 0;
        }


        /* ==============================
           MAIN CONTENT
        ============================== */

        .main-content {

            padding: 30px;
        }


        /* ==============================
           CARDS
        ============================== */

        .dashboard-card {

            border: none;

            border-radius: 15px;
        }


        .stat-card {

            border: none;

            border-radius: 15px;

            transition: 0.2s;
        }


        .stat-card:hover {

            transform: translateY(-3px);
        }


        .stat-icon {

            width: 45px;

            height: 45px;

            border-radius: 10px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 20px;
        }


        /* ==============================
           CHART
        ============================== */

        .chart-container {

            position: relative;

            width: 100%;

            height: 350px;
        }


        /* ==============================
           RANKING
        ============================== */

        .ranking-number {

            width: 32px;

            height: 32px;

            min-width: 32px;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            background-color: #f1f3f5;

            font-size: 13px;

            font-weight: 600;
        }


        .ranking-item {

            padding: 13px 0;

            border-bottom: 1px solid #eeeeee;
        }


        .ranking-item:last-child {

            border-bottom: none;
        }


        /* ==============================
           MOBILE
        ============================== */

        @media (max-width: 767px) {

            .sidebar {

                min-height: auto;

                position: relative;

                border-right: none;

                border-bottom: 1px solid #e5e7eb;
            }


            .main-content {

                padding: 20px 15px;
            }


            .chart-container {

                height: 280px;
            }

        }

    </style>

</head>


<body>


<div class="container-fluid">

    <div class="row">


        <!-- ==========================================
             SIDEBAR
        =========================================== -->

        <div class="col-md-3 col-lg-2 p-0">

            <div class="sidebar">


                <div class="sidebar-title">

                    Admin Panel

                </div>


                <!-- MANAGEMENT -->

                <div class="sidebar-section">

                    Management

                </div>


                <a
                    href="/admin/dashboard"
                    class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>">

                    <i class="bi bi-speedometer2"></i>

                    Dashboard

                </a>


                <a
                    href="/admin/userManagement"
                    class="<%= currentSideBar === 'users' ? 'active' : '' %>">

                    <i class="bi bi-people"></i>

                    Users

                </a>


                <hr>


                <!-- CATALOG -->

                <div class="sidebar-section">

                    Catalog Management

                </div>


                <a
                    href="/admin/category/categories"
                    class="<%= currentSideBar === 'categories' ? 'active' : '' %>">

                    <i class="bi bi-tags"></i>

                    Categories

                </a>


                <a
                    href="/admin/product/products"
                    class="<%= currentSideBar === 'product' ? 'active' : '' %>">

                    <i class="bi bi-box-seam"></i>

                    Products

                </a>


                <hr>


                <!-- ORDERS -->

                <div class="sidebar-section">

                    Order Management

                </div>


                <a
                    href="/admin/orders"
                    class="<%= currentSideBar === 'orders' ? 'active' : '' %>">

                    <i class="bi bi-cart-check"></i>

                    Orders

                </a>


                <a
                    href="/admin/coupons"
                    class="<%= currentSideBar === 'coupons' ? 'active' : '' %>">

                    <i class="bi bi-ticket-perforated"></i>

                    Coupons

                </a>


                <a
                    href="/admin/offers/list"
                    class="<%= currentSideBar === 'offers' ? 'active' : '' %>">

                    <i class="bi bi-percent"></i>

                    Offers

                </a>


                <hr>


                <!-- REPORTS -->

                <div class="sidebar-section">

                    Reports

                </div>


                <a
                    href="/admin/sales-report"
                    class="<%= currentSideBar === 'salesReport' ? 'active' : '' %>">

                    <i class="bi bi-bar-chart-line"></i>

                    Sales Report

                </a>


                <hr>


                <!-- LOGOUT -->

                <a
                    href="/admin/logout"
                    class="text-danger fw-bold">

                    <i class="bi bi-box-arrow-right"></i>

                    Logout

                </a>


            </div>

        </div>



        <!-- ==========================================
             MAIN CONTENT
        =========================================== -->

        <div class="col-md-9 col-lg-10">


            <div class="main-content">


                <!-- HEADER -->

                <div
                    class="d-flex
                           justify-content-between
                           align-items-center
                           flex-wrap
                           gap-3
                           mb-4">


                    <div>

                        <h2 class="fw-bold mb-1">

                            Dashboard

                        </h2>


                        <p class="text-muted mb-0">

                            Overview of your store performance

                        </p>

                    </div>

                </div>



                <!-- ERROR -->

                <% if (typeof error !== "undefined" && error) { %>

                    <div class="alert alert-danger">

                        <%= error %>

                    </div>

                <% } %>



                <!-- ==========================================
                     SUMMARY CARDS
                =========================================== -->

                <div class="row g-4 mb-4">


                    <!-- ORDERS -->

                    <div class="col-xl-3 col-md-6">

                        <div class="card stat-card shadow-sm h-100">

                            <div class="card-body p-4">

                                <div
                                    class="d-flex
                                           justify-content-between
                                           align-items-center">


                                    <div>

                                        <p class="text-muted mb-2">

                                            Total Orders

                                        </p>


                                        <h3 class="fw-bold mb-0">

                                            <%= dashboard.totalOrders || 0 %>

                                        </h3>

                                    </div>


                                    <div class="stat-icon bg-light">

                                        <i class="bi bi-cart-check"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- USERS -->

                    <div class="col-xl-3 col-md-6">

                        <div class="card stat-card shadow-sm h-100">

                            <div class="card-body p-4">

                                <div
                                    class="d-flex
                                           justify-content-between
                                           align-items-center">


                                    <div>

                                        <p class="text-muted mb-2">

                                            Total Users

                                        </p>


                                        <h3 class="fw-bold mb-0">

                                            <%= dashboard.totalUsers || 0 %>

                                        </h3>

                                    </div>


                                    <div class="stat-icon bg-light">

                                        <i class="bi bi-people"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- ITEMS -->

                    <div class="col-xl-3 col-md-6">

                        <div class="card stat-card shadow-sm h-100">

                            <div class="card-body p-4">

                                <div
                                    class="d-flex
                                           justify-content-between
                                           align-items-center">


                                    <div>

                                        <p class="text-muted mb-2">

                                            Items Sold

                                        </p>


                                        <h3 class="fw-bold mb-0">

                                            <%= dashboard.totalItems || 0 %>

                                        </h3>

                                    </div>


                                    <div class="stat-icon bg-light">

                                        <i class="bi bi-box-seam"></i>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>



 

                <!-- ==========================================
                     SALES CHART
                =========================================== -->

                <div class="card dashboard-card shadow-sm mb-4">

                    <div class="card-body p-4">


                        <div
                            class="d-flex
                                   justify-content-between
                                   align-items-center
                                   flex-wrap
                                   gap-3
                                   mb-4">


                            <div>

                                <h5 class="fw-bold mb-1">

                                    Sales Overview

                                </h5>


                                <p class="text-muted mb-0">

                                    View your store sales performance

                                </p>

                            </div>


                            <!-- FILTER -->

                            <form
                                action="/admin/dashboard"
                                method="GET">


                                <select
                                    name="filter"
                                    class="form-select"
                                    onchange="this.form.submit()">


                                    <option
                                        value="yearly"
                                        <%= dashboard.filter === "yearly"
                                            ? "selected"
                                            : "" %>>

                                        Yearly

                                    </option>


                                    <option
                                        value="monthly"
                                        <%= dashboard.filter === "monthly"
                                            ? "selected"
                                            : "" %>>

                                        Monthly

                                    </option>


                                    <option
                                        value="weekly"
                                        <%= dashboard.filter === "weekly"
                                            ? "selected"
                                            : "" %>>

                                        Weekly

                                    </option>


                                    <option
                                        value="daily"
                                        <%= dashboard.filter === "daily"
                                            ? "selected"
                                            : "" %>>

                                        Daily

                                    </option>


                                </select>

                            </form>

                        </div>



                        <!-- CHART -->

                        <div class="chart-container">

                            <canvas id="salesChart"></canvas>

                        </div>


                    </div>

                </div>



                <!-- ==========================================
                     PRODUCTS + CATEGORIES
                =========================================== -->

                <div class="row g-4 mb-4">


                    <!-- TOP PRODUCTS -->

                    <div class="col-lg-6">

                        <div
                            class="card
                                   dashboard-card
                                   shadow-sm
                                   h-100">


                            <div class="card-body p-4">


                                <h5 class="fw-bold mb-4">

                                    Top 10 Best Selling Products

                                </h5>



                                <% if (
                                    !dashboard.bestSellingProducts ||
                                    dashboard.bestSellingProducts.length === 0
                                ) { %>


                                    <div
                                        class="text-center
                                               text-muted
                                               py-5">

                                        No product sales found.

                                    </div>


                                <% } else { %>


                                    <% dashboard.bestSellingProducts.forEach((product, index) => { %>


                                        <div
                                            class="ranking-item
                                                   d-flex
                                                   align-items-center
                                                   justify-content-between
                                                   gap-3">


                                            <div
                                                class="d-flex
                                                       align-items-center
                                                       gap-3
                                                       overflow-hidden">


                                                <div class="ranking-number">

                                                    <%= index + 1 %>

                                                </div>


                                                <div class="text-truncate">


                                                    <div
                                                        class="fw-semibold
                                                               text-truncate">

                                                        <%= product.productName ||
                                                            "Unknown Product" %>

                                                    </div>


                                                    <small class="text-muted">

                                                        <%= product.quantity || 0 %>
                                                        items sold

                                                    </small>

                                                </div>

                                            </div>


                                            <div
                                                class="fw-semibold
                                                       text-nowrap">

                                                ₹<%= Number(
                                                    product.sales || 0
                                                ).toFixed(2) %>

                                            </div>


                                        </div>


                                    <% }); %>


                                <% } %>


                            </div>

                        </div>

                    </div>



                    <!-- TOP CATEGORIES -->




                </div>



                <!-- ==========================================
                     TOP BRANDS
                =========================================== -->

                <div class="card dashboard-card shadow-sm mb-4">

                    <div class="card-body p-4">


                        <h5 class="fw-bold mb-4">

                            Top 10 Best Selling Brands

                        </h5>



                        <% if (
                            !dashboard.bestSellingBrands ||
                            dashboard.bestSellingBrands.length === 0
                        ) { %>


                            <div
                                class="text-center
                                       text-muted
                                       py-5">

                                No brand sales found.

                            </div>


                        <% } else { %>


                            <div class="table-responsive">


                                <table class="table align-middle mb-0">


                                    <thead>

                                        <tr>

                                            <th>
                                                #
                                            </th>

                                            <th>
                                                Brand
                                            </th>

                                            <th class="text-end">
                                                Items Sold
                                            </th>

                                            <!-- <th class="text-end">
                                                Sales
                                            </th> -->

                                        </tr>

                                    </thead>


                                    <tbody>


                                        <% dashboard.bestSellingBrands.forEach((brand, index) => { %>


                                            <tr>


                                                <td>

                                                    <div class="ranking-number">

                                                        <%= index + 1 %>

                                                    </div>

                                                </td>


                                                <td class="fw-semibold">

                                                    <%= brand._id ||
                                                        "Unknown Brand" %>

                                                </td>


                                                <td class="text-end">

                                                    <%= brand.quantity || 0 %>

                                                </td>


                                                <!-- <td
                                                    class="text-end
                                                           fw-semibold">

                                                    ₹<%= Number(
                                                        brand.sales || 0
                                                    ).toFixed(2) %>

                                                </td> -->


                                            </tr>


                                        <% }); %>


                                    </tbody>

                                </table>

                            </div>


                        <% } %>


                    </div>

                </div>







            </div>

        </div>

    </div>

</div>



<!-- ==========================================================
     CHART
=========================================================== -->

<script>


    /*
     * Convert backend data into JavaScript.
     */

    const chartLabels = <%- JSON.stringify(
        dashboard.chart.labels || []
    ) %>;


    const chartSales = <%- JSON.stringify(
        dashboard.chart.sales || []
    ) %>;


    const currentFilter =
        "<%= dashboard.filter || 'yearly' %>";



    /*
     * Get chart element
     */

    const salesChart =
        document.getElementById("salesChart");



    /*
     * Chart title
     */

    let chartLabel = "Sales";


    if (currentFilter === "yearly") {

        chartLabel = "Monthly Sales";

    }

    else if (currentFilter === "monthly") {

        chartLabel = "Daily Sales";

    }

    else if (currentFilter === "weekly") {

        chartLabel = "Daily Sales";

    }

    else if (currentFilter === "daily") {

        chartLabel = "Hourly Sales";

    }



    /*
     * Create chart
     */

    new Chart(
        salesChart,
        {

            type: "line",


            data: {

                labels: chartLabels,


                datasets: [

                    {

                        label: chartLabel,

                        data: chartSales,

                        tension: 0.3,

                        fill: true,

                        borderWidth: 2

                    }

                ]

            },


            options: {

                responsive: true,

                maintainAspectRatio: false,


                interaction: {

                    intersect: false,

                    mode: "index"

                },


                plugins: {

                    legend: {

                        display: true

                    },


                    tooltip: {

                        callbacks: {

                            label: function(context) {

                                return (
                                    " Sales: ₹" +
                                    Number(
                                        context.parsed.y || 0
                                    ).toFixed(2)
                                );

                            }

                        }

                    }

                },


                scales: {

                    y: {

                        beginAtZero: true,


                        ticks: {

                            callback: function(value) {

                                return "₹" + value;

                            }

                        }

                    }

                }

            }

        }

    );

</script>


</body>

</html>
```
