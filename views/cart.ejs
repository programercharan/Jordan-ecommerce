<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>



document.querySelectorAll(".increase-btn")

.forEach(button=>{

    button.addEventListener("click",async()=>{

        const variantId=button.dataset.variant;

        const size=button.dataset.size;

        const res=await fetch("/user/cart/update",{

            method:"POST",

            headers:{

                "Content-Type":"application/json"

            },

            body:JSON.stringify({

                variantId,

                size,

                action:"inc"

            })

        });

        const data=await res.json();

        if(data.success){

const card = button.closest(".cart-card");

card.querySelector(".qty-value").textContent = data.quantity;
card.querySelector(".subtotal").textContent = data.subtotal;

document.getElementById("totalProducts").textContent =
    data.totalProducts;

document.getElementById("totalQuantity").textContent =
    data.totalQuantity;
document.getElementById("cartTotal").textContent =
"₹" + data.total;
        }else{
                Swal.fire({
                    icon:"error",
                    title:data.message
                })
            // alert(data.message);

        }

    });

});



document.querySelectorAll(".decrease-btn")

.forEach(button=>{

    button.addEventListener("click",async()=>{

        const variantId=button.dataset.variant;

        const size=button.dataset.size;

        const res=await fetch("/user/cart/update",{

            method:"POST",

            headers:{

                "Content-Type":"application/json"

            },

            body:JSON.stringify({

                variantId,

                size,

                action:"dec"

            })

        });

        const data=await res.json();

        if(data.success){

    const card = button.closest(".cart-card");

card.querySelector(".qty-value").textContent = data.quantity;
card.querySelector(".subtotal").textContent = data.subtotal;

document.getElementById("totalProducts").textContent =
    data.totalProducts;

document.getElementById("totalQuantity").textContent =
    data.totalQuantity;
document.getElementById("cartTotal").textContent ="₹" + data.total;

        }else{
                return Swal.fire({
                    icon:"error",
                    title:data.message
                })            
            // alert(data.message);

        }

    });

});



document.querySelectorAll(".remove-btn")

.forEach(button=>{

    button.addEventListener("click",async()=>{
        console.log("Remove button clicked");
        const variantId=button.dataset.variant;

        const size=button.dataset.size;

        const res=await fetch("/user/cart/remove",{

            method:"POST",

            headers:{

                "Content-Type":"application/json"

            },

            body:JSON.stringify({

                variantId,

                size

            })

        });

        const data=await res.json();

        if(data.success){

button.closest(".cart-card").remove();

document.getElementById("cartTotal").textContent ="₹" + data.total;
document.getElementById("totalProducts").textContent =data.totalProducts;

document.getElementById("totalQuantity").textContent =data.totalQuantity;
document.getElementById("totalQuantity").textContent =data.totalQuantity;

document.getElementById("totalProducts").textContent =data.totalProducts;


        }else{
                Swal.fire({
                    icon:"error",
                    title:data.message
                })
            // alert(data.message);

        }

    });

});



async function validateCheckout() {

    const checkoutError =
        document.getElementById("checkoutError");

    checkoutError.innerHTML = "";

    try {

        const response = await fetch("/user/validate-checkout", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            }
        });


        const data = await response.json();


        console.log("Validate checkout response:", data);


        // --------------------------------
        // EVERYTHING IS VALID
        // --------------------------------

        if (data.success) {
            console.log("validator executed redirecting to /checkout")
            window.location.href = "/user/checkout";

            return;
        }


        let html = `
            <div class="alert alert-danger">

                <strong>
                    ${data.message}
                </strong>
        `;


        // --------------------------------
        // UNAVAILABLE PRODUCTS
        // --------------------------------

        if (
            data.unavailableProducts &&
            data.unavailableProducts.length > 0
        ) {

            html += `
                <div class="mt-3">

                    <strong>
                        Unavailable products:
                    </strong>

                    <ul class="mb-2">
            `;


            data.unavailableProducts.forEach(product => {

                html += `
                    <li>
                        <strong>
                            ${product.name}
                        </strong>
                        - ${product.reason}
                    </li>
                `;

            });


            html += `
                    </ul>

                </div>
            `;
        }


        // --------------------------------
        // OUT OF STOCK / INSUFFICIENT STOCK
        // --------------------------------

        if (
            data.outOfStockProducts &&
            data.outOfStockProducts.length > 0
        ) {

            html += `
                <div class="mt-3">

                    <strong>
                        Products with insufficient stock:
                    </strong>

                    <ul class="mb-2">
            `;


            data.outOfStockProducts.forEach(product => {

                html += `
                    <li>

                        <strong>
                            ${product.name}
                        </strong>

                        - Size ${product.size}

                        - Requested:
                        ${product.requestedQuantity}

                        - Available:
                        ${product.availableStock}

                    </li>
                `;

            });


            html += `
                    </ul>

                </div>
            `;
        }


        html += `

                <div class="mt-2">
                    Please remove or update these products
                    and proceed with the remaining products.
                </div>

            </div>
        `;


        checkoutError.innerHTML = html;


    } catch (error) {

        console.error(
            "Validate checkout error:",
            error
        );


        checkoutError.innerHTML = `
            <div class="alert alert-danger">
                Something went wrong.
                Please try again.
            </div>
        `;
    }
}


</script>

</body>

</html>
