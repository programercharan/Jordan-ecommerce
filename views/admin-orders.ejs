<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Admin Orders</title>


<!-- Bootstrap -->

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">


<!-- Bootstrap Icons -->

<link
rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">


<style>

/* ==========================================
   BODY
========================================== */

body {

    background-color: #f5f6f8;

    margin: 0;

    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;

}


/* ==========================================
   SIDEBAR
========================================== */

.sidebar {

    background-color: #ffffff;

    min-height: 100vh;

    padding: 25px 18px;

    border-right: 1px solid #e5e7eb;

    position: sticky;

    top: 0;

}


.sidebar-title {

    font-size: 21px;

    font-weight: 700;

    margin-bottom: 30px;

    padding-left: 10px;

}


.sidebar-section {

    font-size: 11px;

    font-weight: 700;

    color: #8a8f98;

    text-transform: uppercase;

    margin-top: 20px;

    margin-bottom: 8px;

    padding-left: 10px;

}


.sidebar a {

    display: flex;

    align-items: center;

    gap: 10px;

    text-decoration: none;

    color: #555b65;

    padding: 11px 12px;

    margin-bottom: 4px;

    border-radius: 8px;

    font-size: 14px;

    transition: 0.2s;

}


.sidebar a:hover {

    background-color: #f1f3f5;

    color: #212529;

}


.sidebar a.active {

    background-color: #212529;

    color: #ffffff;

}


.sidebar hr {

    border: 0;

    border-top: 1px solid #eeeeee;

    margin: 20px 0;

}


/* ==========================================
   MAIN CONTENT
========================================== */

.main-content {

    padding: 30px;

}


/* ==========================================
   ORDER CARD
========================================== */

.order-card {

    border: none;

    border-radius: 15px;

}


/* ==========================================
   TABLE
========================================== */

.table-container {

    background: #ffffff;

    border-radius: 15px;

    padding: 20px;

}


/* ==========================================
   MOBILE
========================================== */

@media (max-width: 767px) {

    .sidebar {

        min-height: auto;

        position: relative;

        border-right: none;

        border-bottom: 1px solid #e5e7eb;

    }


    .main-content {

        padding: 20px 15px;

    }

}

</style>

</head>


<body>


<div class="container-fluid">

<div class="row">


<!-- ==========================================
     SIDEBAR
========================================== -->

<div class="col-md-3 col-lg-2 p-0">


<div class="sidebar">


<!-- SIDEBAR TITLE -->

<div class="sidebar-title">

    Admin Panel

</div>



<!-- ==========================================
     MANAGEMENT
========================================== -->

<div class="sidebar-section">

    Management

</div>


<a
href="/admin/dashboard"
class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>">

<i class="bi bi-speedometer2"></i>

Dashboard

</a>


<a
href="/admin/userManagement"
class="<%= currentSideBar === 'users' ? 'active' : '' %>">

<i class="bi bi-people"></i>

Users

</a>



<hr>



<!-- ==========================================
     CATALOG MANAGEMENT
========================================== -->

<div class="sidebar-section">

    Catalog Management

</div>


<a
href="/admin/category/categories"
class="<%= currentSideBar === 'categories' ? 'active' : '' %>">

<i class="bi bi-tags"></i>

Categories

</a>


<a
href="/admin/product/products"
class="<%= currentSideBar === 'product' ? 'active' : '' %>">

<i class="bi bi-box-seam"></i>

Products

</a>



<hr>



<!-- ==========================================
     ORDER MANAGEMENT
========================================== -->

<div class="sidebar-section">

    Order Management

</div>


<a
href="/admin/orders"
class="<%= currentSideBar === 'orders' ? 'active' : '' %>">

<i class="bi bi-cart-check"></i>

Orders

</a>


<a
href="/admin/coupons"
class="<%= currentSideBar === 'coupons' ? 'active' : '' %>">

<i class="bi bi-ticket-perforated"></i>

Coupons

</a>


<a
href="/admin/offers/list"
class="<%= currentSideBar === 'offers' ? 'active' : '' %>">

<i class="bi bi-percent"></i>

Offers

</a>



<hr>



<!-- ==========================================
     REPORTS
========================================== -->

<div class="sidebar-section">

    Reports

</div>


<a
href="/admin/sales-report"
class="<%= currentSideBar === 'salesReport' ? 'active' : '' %>">

<i class="bi bi-bar-chart-line"></i>

Sales Report

</a>



<hr>



<!-- LOGOUT -->

<a
href="/admin/logout"
class="text-danger fw-bold">

<i class="bi bi-box-arrow-right"></i>

Logout

</a>


</div>

</div>



<!-- ==========================================
     MAIN CONTENT
========================================== -->

<div class="col-md-9 col-lg-10">


<div class="main-content">


<div class="card order-card shadow-sm">


<div class="card-body">


<!-- ==========================================
     PAGE TITLE
========================================== -->

<h2 class="fw-bold mb-4">

Orders

</h2>



<!-- ==========================================
     SEARCH
========================================== -->

<form
action="/admin/orders"
method="GET"
class="d-flex gap-2 flex-wrap mb-4">


<input
type="text"
name="search"
class="form-control"
style="width:250px"
placeholder="Search Order ID"
value="<%= search || '' %>">


<input
type="hidden"
name="sort"
value="<%= sort %>">


<input
type="hidden"
name="status"
value="<%= status %>">


<button class="btn btn-dark">

Search

</button>


<a
href="/admin/orders"
class="btn btn-outline-secondary">

Clear

</a>


</form>



<!-- ==========================================
     SORT + STATUS FILTER
========================================== -->

<div class="d-flex gap-3 mb-4 flex-wrap">

    <!-- SORT -->

    <div>
        <label for="sort" class="form-label fw-semibold">
            Sort
        </label>

        <select
            class="form-select"
            id="sort">

            <option
                value="newest"
                <%= sort === "newest" ? "selected" : "" %>>
                Newest First
            </option>

            <option
                value="oldest"
                <%= sort === "oldest" ? "selected" : "" %>>
                Oldest First
            </option>

        </select>
    </div>


    <!-- STATUS -->

    <div>
        <label for="statusFilter" class="form-label fw-semibold">
            Status
        </label>

        <select
            class="form-select"
            id="statusFilter">

            <option
                value=""
                <%= !status ? "selected" : "" %>>
                All
            </option>

            <option
                value="Confirmed"
                <%= status === "Confirmed" ? "selected" : "" %>>
                Confirmed
            </option>

            <option
                value="Shipped"
                <%= status === "Shipped" ? "selected" : "" %>>
                Shipped
            </option>

            <option
                value="Delivered"
                <%= status === "Delivered" ? "selected" : "" %>>
                Delivered
            </option>

            <option
                value="Cancelled"
                <%= status === "Cancelled" ? "selected" : "" %>>
                Cancelled
            </option>

            <option
                value="Return Requested"
                <%= status === "Return Requested" ? "selected" : "" %>>
                Return Requested
            </option>

            <option
                value="Returned"
                <%= status === "Returned" ? "selected" : "" %>>
                Returned
            </option>

        </select>
    </div>

</div>






<!-- ==========================================
     ORDER TABLE
========================================== -->

<div class="table-responsive">


<table class="table table-hover align-middle">


<thead class="table-dark">


<tr>

<th>

Order ID

</th>


<th>

Customer

</th>


<th>

Order Date

</th>


<th>

Grand Total

</th>


<th>

Payment

</th>


<th>

Status

</th>


<th>

</th>

</tr>


</thead>


<tbody>


<% if(orders.length===0){ %>


<tr>

<td
colspan="7"
class="text-center py-5">

No Orders Found

</td>

</tr>


<% } else { %>


<% orders.forEach(order=>{ %>


<tr>


<!-- ORDER ID -->

<td>

<strong>

<%= order.orderId %>

</strong>

</td>



<!-- CUSTOMER -->

<td>

<%= order.shippingAddress.firstName %>

<%= order.shippingAddress.lastName %>

</td>



<!-- ORDER DATE -->

<td>

<%= new Date(order.createdAt).toLocaleDateString("en-IN") %>

</td>



<!-- GRAND TOTAL -->

<td>

₹<%= order.grandTotal %>

</td>



<!-- PAYMENT -->

<td>

<%= order.paymentMethod %>

</td>



<!-- STATUS -->

<td>


<%

let badge="secondary";


if(order.orderStatus==="Confirmed"){

    badge="primary";

}

else if(order.orderStatus==="Shipped"){

    badge="info";

}

else if(order.orderStatus==="Out for Delivery"){

    badge="warning text-dark";

}

else if(order.orderStatus==="Delivered"){

    badge="success";

}

else if(order.orderStatus==="Cancelled"){

    badge="danger";

}

else if(order.orderStatus==="Return Requested"){

    badge="warning";

}

else if(order.orderStatus==="Returned"){

    badge="dark";

}

%>


<span
class="badge bg-<%= badge %>">

<%= order.orderStatus %>

</span>


</td>



<!-- VIEW DETAILS -->

<td>


<a
href="/admin/orders/<%= order._id %>"
class="btn btn-dark btn-sm">

View Details

</a>


</td>


</tr>


<% }) %>


<% } %>


</tbody>


</table>


</div>



<!-- ==========================================
     PAGINATION
========================================== -->

<nav>


<ul class="pagination justify-content-center mt-4">


<% if(currentPage>1){ %>


<li class="page-item">


<a
class="page-link"
href="?page=<%= currentPage-1 %>&search=<%= search %>&sort=<%= sort %>&status=<%= status %>">

Previous

</a>


</li>


<% } %>



<% for(let i=1;i<=totalPages;i++){ %>


<li
class="page-item <%= currentPage===i?'active':'' %>">


<a
class="page-link"
href="?page=<%= i %>&search=<%= search %>&sort=<%= sort %>&status=<%= status %>">

<%= i %>

</a>


</li>


<% } %>



<% if(currentPage<totalPages){ %>


<li class="page-item">


<a
class="page-link"
href="?page=<%= currentPage+1 %>&search=<%= search %>&sort=<%= sort %>&status=<%= status %>">

Next

</a>


</li>


<% } %>


</ul>


</nav>


</div>


</div>


</div>


</div>


</div>


</body>

</html>

<script>

const sort = document.getElementById("sort");

const statusFilter = document.getElementById("statusFilter");


function updateUrl() {

    const url = new URL(window.location.href);


    // Keep current search

    // Change only sort

    url.searchParams.set("sort", sort.value);


    // Keep current status

    // Change only status

    if (statusFilter.value) {

        url.searchParams.set(
            "status",
            statusFilter.value
        );

    } else {

        url.searchParams.delete("status");

    }


    // Reset pagination

    url.searchParams.set("page", "1");


    window.location.href = url.toString();

}


sort.addEventListener("change", updateUrl);

statusFilter.addEventListener("change", updateUrl);

</script>

