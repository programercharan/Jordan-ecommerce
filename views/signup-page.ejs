<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>JORDAN – Signup</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    /* Eye hover effect */
    .toggle-password:hover {
      color: #000;
    }
  </style>
  
</head>

<body class="bg-light d-flex flex-column justify-content-center align-items-center vh-100">


<div class="text-center mb-4">
    <h2 class="fw-bold">JORDAN</h2>
    <p class="text-muted small">Crafted for Comfort and Style</p>
  </div>

  <!-- Signup Card -->
  <div class="card shadow p-4" style="width: 400px;">
      <h5 class="fw-semibold mt-2 mb-3">Create Account</h5>

      <!-- 1. MULTIPLE BACKEND ERRORS LISTED TOGETHER ABOVE THE FORM -->
      <% if (typeof errorMessages !== 'undefined' && Object.keys(errorMessages).length > 0) { %>
          <div class="alert alert-danger pb-0">
              <ul class="ps-3 mb-2">
                  <% Object.keys(errorMessages).forEach(field => { %>
                      <li><%= errorMessages[field] %></li>
                  <% }) %>
              </ul>
          </div>
      <% } else if (typeof error !== 'undefined' && error) { %>
          <!-- Fallback for standard single-string flash errors -->
          <div class="alert alert-danger">
              <%= error %>
          </div>
      <% } %>

      <!-- Form tracking with inline input box state injection -->
      <form id="signupForm" action="/user/signup" method="post" novalidate>
        <small id="credentialsError" class="text-danger"></small>

        <!-- First Name & Last Name inline -->
        <div class="row mb-3">
          <div class="col">
            <!-- Added backend value injection -->
            <input type="text" class="form-control" id="firstName" name="firstName" placeholder="First Name" 
                   value="<%= typeof oldInput !== 'undefined' ? oldInput?.firstName : '' %>">
            <!-- Empty layout structures kept clean for frontend js framework tracking -->
            <div style="min-height:1em;"><small id="firstNameError" class="text-danger"></small></div>
          </div>
          <div class="col">
            <input type="text" class="form-control" id="lastName" name="lastName" placeholder="Last Name"
                   value="<%= typeof oldInput !== 'undefined' ? oldInput?.lastName : '' %>">
            <div style="min-height:1em;"><small id="lastNameError" class="text-danger"></small></div>
          </div>
        </div>

        <!-- Email -->
        <div class="mb-3">
          <input type="email" class="form-control" id="email" name="email" placeholder="Email Address"
                 value="<%= typeof oldInput !== 'undefined' ? oldInput?.email : '' %>">
          <div style="min-height:1em;"><small id="emailError" class="text-danger"></small></div>
        </div>

        <!-- Phone Number -->
        <div class="mb-3">
          <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber" placeholder="Phone Number"
                 value="<%= typeof oldInput !== 'undefined' ? oldInput?.phoneNumber : '' %>">
          <div style="min-height:1em;"><small id="phoneError" class="text-danger"></small></div>
        </div>

        <div class="row mb-3">
          <div class="col">
            <input type="text" class="form-control" id="referralCode" name="referralCode" placeholder="Referral Code"
                   value="<%= typeof oldInput !== 'undefined' ? oldInput?.referralCode : '' %>">
          </div>
        </div>

        <!-- Password -->
        <div class="mb-3 position-relative">
          <div class="position-relative">
            <!-- Kept empty for security compliance -->
            <input type="password" class="form-control pe-5" id="password" name="password" placeholder="Password">
            <i class="bi bi-eye-slash position-absolute end-0 top-50 translate-middle-y me-3 fs-5 toggle-password"
               id="togglePassword" style="cursor:pointer; color: #6c757d;"></i>
          </div>
          <div style="min-height:1em;"><small id="passwordError" class="text-danger"></small></div>
        </div>

        <!-- Confirm Password -->
        <div class="mb-3 position-relative">
          <div class="position-relative">
            <!-- FIX: Added name="confirmPassword" attribute so express-validator can detect it -->
            <input type="password" class="form-control pe-5" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password">
            <i class="bi bi-eye-slash position-absolute end-0 top-50 translate-middle-y me-3 fs-5 toggle-password"
               id="toggleConfirmPassword" style="cursor:pointer; color: #6c757d;"></i>
          </div>
          <div style="min-height:1em;"><small id="confirmPasswordError" class="text-danger"></small></div>
        </div>

        <!-- Create Account Button -->
        <div class="d-grid mb-3">
          <button type="submit" class="btn btn-dark">Create Account</button>
        </div>

        <div class="d-grid mb-3">
            <a href="/user/google" class="btn btn-danger">
                Sign in with Google
            </a>
        </div>

        <!-- Already have account -->
        <div class="text-center">
          <a href="/user/login" class="fw-bold fs-5 text-decoration-underline">Sign In</a>
          <div class="text-muted small">Already have an account?</div>
        </div>
      </form>
  </div>




<script>
const form = document.getElementById("signupForm");

const firstNameInput = document.getElementById("firstName");
const lastNameInput = document.getElementById("lastName");
const emailInput = document.getElementById("email");
const phoneInput = document.getElementById("phoneNumber");
const referralCodeInput = document.getElementById("referralCode");
const passwordInput = document.getElementById("password");
const confirmPasswordInput = document.getElementById("confirmPassword");

// Error message elements
const credentialsError = document.getElementById("credentialsError");
const firstNameError = document.getElementById("firstNameError");
const lastNameError = document.getElementById("lastNameError");
const emailError = document.getElementById("emailError");
const phoneError = document.getElementById("phoneError");
const passwordError = document.getElementById("passwordError");
const confirmPasswordError = document.getElementById("confirmPasswordError");

// Password visibility buttons
const togglePassword = document.getElementById("togglePassword");
const toggleConfirmPassword = document.getElementById("toggleConfirmPassword");

// Show/hide password
togglePassword.addEventListener("click", () => {
    if (passwordInput.type === "password") {
        passwordInput.type = "text";
        togglePassword.classList.replace("bi-eye-slash", "bi-eye");
    } else {
        passwordInput.type = "password";
        togglePassword.classList.replace("bi-eye", "bi-eye-slash");
    }
});

toggleConfirmPassword.addEventListener("click", () => {
    if (confirmPasswordInput.type === "password") {
        confirmPasswordInput.type = "text";
        toggleConfirmPassword.classList.replace("bi-eye-slash", "bi-eye");
    } else {
        confirmPasswordInput.type = "password";
        toggleConfirmPassword.classList.replace("bi-eye", "bi-eye-slash");
    }
});

form.addEventListener("submit", (e) => {
    e.preventDefault();

    let hasError = false;

    // Get field values
    const firstName = firstNameInput.value.trim();
    const lastName = lastNameInput.value.trim();
    const email = emailInput.value.trim();
    const phone = phoneInput.value.trim();
    const referralCode = referralCodeInput.value.trim();
    const password = passwordInput.value;
    const confirmPassword = confirmPasswordInput.value;

    // Clear previous error messages
    credentialsError.innerText = "";
    firstNameError.innerText = "";
    lastNameError.innerText = "";
    emailError.innerText = "";
    phoneError.innerText = "";
    passwordError.innerText = "";
    confirmPasswordError.innerText = "";

    // FIRST NAME
    if (firstName === "") {
        firstNameError.innerText = "Enter first name";
        hasError = true;
    } else if (!/^[a-zA-Z]+(?:[ '-][a-zA-Z]+)*$/.test(firstName)) {
        firstNameError.innerText = "Enter a valid first name";
        hasError = true;
    }

    // LAST NAME
    if (lastName === "") {
        lastNameError.innerText = "Enter last name";
        hasError = true;
    } else if (!/^[a-zA-Z]+(?:[ '-][a-zA-Z]+)*$/.test(lastName)) {
        lastNameError.innerText = "Enter a valid last name";
        hasError = true;
    }

    // EMAIL
    if (email === "") {
        emailError.innerText = "Enter email address";
        hasError = true;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        emailError.innerText = "Enter a valid email address";
        hasError = true;
    }

    // PHONE NUMBER
    if (phone === "") {
        phoneError.innerText = "Enter phone number";
        hasError = true;
    } else if (!/^[6-9]\d{9}$/.test(phone)) {
        phoneError.innerText = "Enter a valid 10-digit Indian mobile number";
        hasError = true;
    }

    // PASSWORD
    if (password.trim() === "") {
        passwordError.innerText = "Enter password";
        hasError = true;
    } else {
        const checks = {
            length: password.length >= 8,
            lowercase: /[a-z]/.test(password),
            uppercase: /[A-Z]/.test(password),
            number: /\d/.test(password),
            specialChar: /[@$!%*?&]/.test(password)
        };

        const errorMessages = {
            length: "Password must contain at least 8 characters.",
            lowercase: "Password must contain a lowercase letter.",
            uppercase: "Password must contain an uppercase letter.",
            number: "Password must contain a number.",
            specialChar: "Password must contain a special character (@$!%*?&)."
        };

        Object.entries(checks).forEach(([key, isValid]) => {
            if (!isValid) {
                passwordError.innerHTML += errorMessages[key] + "<br>";
                hasError = true;
            }
        });
    }

    // CONFIRM PASSWORD
    if (confirmPassword === "") {
        confirmPasswordError.innerText = "Enter confirm password";
        hasError = true;
    } else if (password !== confirmPassword) {
        confirmPasswordError.innerText =
            "Confirm password doesn't match the password";
        hasError = true;
    }

    // REFERRAL CODE IS OPTIONAL
    // No validation is required unless a referral code is entered.
    // The backend should verify whether the code is valid.

    // SUBMIT FORM
    if (!hasError) {
        form.submit();
    }
});


// ==================================================
// TOGGLE PASSWORD
// ==================================================

togglePassword.addEventListener("click", () => {
    const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
    passwordInput.setAttribute("type", type);

    // FIX: Toggle the classes directly on togglePassword
    togglePassword.classList.toggle("bi-eye");
    togglePassword.classList.toggle("bi-eye-slash");
});




// ==================================================
// TOGGLE CONFIRM PASSWORD
// ==================================================

toggleConfirmPassword.addEventListener("click", () => {

    const type =
        confirmPasswordInput.getAttribute("type") === "password"
            ? "text"
            : "password";


    confirmPasswordInput.setAttribute(
        "type",
        type
    );

    toggleConfirmPassword.classList.toggle("bi-eye");
    toggleConfirmPassword.classList.toggle("bi-eye-slash");

});


// ==================================================
// SWEET ALERT
// ==================================================

const alertData =
    <%- JSON.stringify(alert || null) %>;


if (alertData) {

    Swal.fire({

        icon:
            alertData.type,

        title:
            alertData.message,

        confirmButtonText:
            "OK"

    });

}

</script>

</body>
</html>