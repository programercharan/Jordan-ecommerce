
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>User Management</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">


    <!-- SweetAlert -->

    <script
        src="https://cdn.jsdelivr.net/npm/sweetalert2@11">
    </script>


    <style>

        /* ==============================
           BODY
        ============================== */

        body {

            background-color: #f5f6f8;

            margin: 0;

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;

        }


        /* ==============================
           SIDEBAR
        ============================== */

        .sidebar {

            background-color: #ffffff;

            min-height: 100vh;

            padding: 25px 18px;

            border-right: 1px solid #e5e7eb;

            position: sticky;

            top: 0;

        }


        .sidebar-title {

            font-size: 21px;

            font-weight: 700;

            margin-bottom: 30px;

            padding-left: 10px;

        }


        .sidebar-section {

            font-size: 11px;

            font-weight: 700;

            color: #8a8f98;

            text-transform: uppercase;

            margin-top: 20px;

            margin-bottom: 8px;

            padding-left: 10px;

        }


        .sidebar a {

            display: flex;

            align-items: center;

            gap: 10px;

            text-decoration: none;

            color: #555b65;

            padding: 11px 12px;

            margin-bottom: 4px;

            border-radius: 8px;

            font-size: 14px;

            transition: 0.2s;

        }


        .sidebar a:hover {

            background-color: #f1f3f5;

            color: #212529;

        }


        .sidebar a.active {

            background-color: #212529;

            color: #ffffff;

        }


        .sidebar hr {

            border: 0;

            border-top: 1px solid #eeeeee;

            margin: 20px 0;

        }


        /* ==============================
           MAIN CONTENT
        ============================== */

        .main-content {

            padding: 30px;

        }


        /* ==============================
           PAGE TITLE
        ============================== */

        .page-title {

            font-size: 28px;

            font-weight: 700;

            margin-bottom: 25px;

        }


        /* ==============================
           SEARCH CARD
        ============================== */

        .search-card {

            background-color: #ffffff;

            border: none;

            border-radius: 15px;

            padding: 20px;

            margin-bottom: 20px;

        }


        /* ==============================
           TABLE CARD
        ============================== */

        .table-container {

            background-color: #ffffff;

            padding: 25px;

            border-radius: 15px;

            border: none;

            box-shadow:
                0 2px 8px rgba(0, 0, 0, 0.04);

        }


        .table {

            margin-bottom: 0;

        }


        .table thead th {

            background-color: #212529;

            color: #ffffff;

            border: none;

            font-size: 13px;

            font-weight: 600;

            padding: 14px 12px;

        }


        .table tbody td {

            padding: 14px 12px;

            font-size: 14px;

        }


        .table tbody tr {

            border-bottom: 1px solid #eeeeee;

        }


        .table tbody tr:last-child {

            border-bottom: none;

        }


        /* ==============================
           STATUS
        ============================== */

        .status-active {

            display: inline-block;

            background-color: #d1e7dd;

            color: #146c43;

            padding: 5px 12px;

            border-radius: 20px;

            font-size: 12px;

            font-weight: 600;

        }


        .status-blocked {

            display: inline-block;

            background-color: #f8d7da;

            color: #b02a37;

            padding: 5px 12px;

            border-radius: 20px;

            font-size: 12px;

            font-weight: 600;

        }


        /* ==============================
           BUTTONS
        ============================== */

        .action-btn {

            min-width: 85px;

        }


        /* ==============================
           PAGINATION
        ============================== */

        .pagination {

            margin-bottom: 0;

        }


        .page-link {

            color: #212529;

            border-color: #dee2e6;

        }


        .page-item.active .page-link {

            background-color: #212529;

            border-color: #212529;

        }


        .page-link:hover {

            color: #212529;

        }


        /* ==============================
           MOBILE
        ============================== */

        @media (max-width: 767px) {

            .sidebar {

                min-height: auto;

                position: relative;

                border-right: none;

                border-bottom: 1px solid #e5e7eb;

            }


            .main-content {

                padding: 20px 15px;

            }


            .table-container {

                padding: 15px;

                overflow-x: auto;

            }


            .table {

                min-width: 750px;

            }

        }

    </style>


    <!-- Refresh page when navigating back -->

    <script>

        window.addEventListener(
            'pageshow',
            function(event) {

                if (
                    event.persisted ||
                    (
                        window.performance &&
                        window.performance.navigation.type === 2
                    )
                ) {

                    window.location.reload();

                }

            }
        );

    </script>

</head>


<body>


<div class="container-fluid">

    <div class="row">


        <!-- ==========================================
             SIDEBAR
        =========================================== -->

        <div class="col-md-3 col-lg-2 p-0">

            <div class="sidebar">


                <!-- TITLE -->

                <div class="sidebar-title">

                    Admin Panel

                </div>


                <!-- ==================================
                     MANAGEMENT
                =================================== -->

                <div class="sidebar-section">

                    Management

                </div>


                <!-- Dashboard -->

                <a
                    href="/admin/dashboard"
                    class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>">

                    <i class="bi bi-speedometer2"></i>

                    Dashboard

                </a>


                <!-- Users -->

                <a
                    href="/admin/userManagement"
                    class="<%= currentSideBar === 'users' ? 'active' : '' %>">

                    <i class="bi bi-people"></i>

                    Users

                </a>


                <hr>


                <!-- ==================================
                     CATALOG
                =================================== -->

                <div class="sidebar-section">

                    Catalog Management

                </div>


                <!-- Categories -->

                <a
                    href="/admin/category/categories"
                    class="<%= currentSideBar === 'categories' ? 'active' : '' %>">

                    <i class="bi bi-tags"></i>

                    Categories

                </a>


                <!-- Products -->

                <a
                    href="/admin/product/products"
                    class="<%= currentSideBar === 'product' ? 'active' : '' %>">

                    <i class="bi bi-box-seam"></i>

                    Products

                </a>


                <!-- Variants -->

                <!--
                <a
                    href="/admin/variant/variants"
                    class="<%= currentSideBar === 'variant' ? 'active' : '' %>">

                    <i class="bi bi-grid"></i>

                    Variants

                </a>
                -->


                <hr>


                <!-- ==================================
                     ORDER MANAGEMENT
                =================================== -->

                <div class="sidebar-section">

                    Order Management

                </div>


                <!-- Orders -->

                <a
                    href="/admin/orders"
                    class="<%= currentSideBar === 'orders' ? 'active' : '' %>">

                    <i class="bi bi-cart-check"></i>

                    Orders

                </a>


                <!-- Coupons -->

                <a
                    href="/admin/coupons"
                    class="<%= currentSideBar === 'coupons' ? 'active' : '' %>">

                    <i class="bi bi-ticket-perforated"></i>

                    Coupons

                </a>


                <!-- Offers -->

                <a
                    href="/admin/offers/list"
                    class="<%= currentSideBar === 'offers' ? 'active' : '' %>">

                    <i class="bi bi-percent"></i>

                    Offers

                </a>


                <hr>


                <!-- ==================================
                     REPORTS
                =================================== -->

                <div class="sidebar-section">

                    Reports

                </div>


                <!-- Sales Report -->

                <a
                    href="/admin/sales-report"
                    class="<%= currentSideBar === 'salesReport' ? 'active' : '' %>">

                    <i class="bi bi-bar-chart-line"></i>

                    Sales Report

                </a>


                <hr>


                <!-- ==================================
                     LOGOUT
                =================================== -->

                <a
                    href="/admin/logout"
                    class="text-danger fw-bold">

                    <i class="bi bi-box-arrow-right"></i>

                    Logout

                </a>


            </div>

        </div>



        <!-- ==========================================
             MAIN CONTENT
        =========================================== -->

        <div class="col-md-9 col-lg-10">


            <div class="main-content">


                <!-- PAGE TITLE -->

                <h3 class="page-title">

                    User Management

                </h3>



                <!-- ==================================
                     SEARCH
                =================================== -->

                <div class="search-card">

                    <form
                        method="GET"
                        action="/admin/userManagement"
                        class="row g-2 align-items-center">


                        <div class="col-md-6">

                            <input
                                type="text"
                                name="search"
                                class="form-control"
                                placeholder="Search by name or email"
                                value="<%= search || '' %>">

                        </div>


                        <div class="col-auto">

                            <button
                                type="submit"
                                class="btn btn-dark">

                                <i class="bi bi-search"></i>

                                Search

                            </button>

                        </div>


                        <div class="col-auto">

                            <a
                                href="/admin/userManagementa"
                                class="btn btn-outline-secondary">

                                <i class="bi bi-x-circle"></i>

                                Clear

                            </a>

                        </div>


                    </form>

                </div>



                <!-- ==================================
                     USER TABLE
                =================================== -->

                <div class="table-container">


                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h5 class="fw-bold mb-1">

                                Users

                            </h5>

                            <p class="text-muted mb-0">

                                Manage registered users

                            </p>

                        </div>

                    </div>



                    <div class="table-responsive">

                        <table
                            class="table table-hover text-center align-middle">


                            <thead>

                                <tr>

                                    <th>
                                        First Name
                                    </th>

                                    <th>
                                        Last Name
                                    </th>

                                    <th>
                                        Email
                                    </th>

                                    <th>
                                        Phone Number
                                    </th>

                                    <th>
                                        Status
                                    </th>
                                     <th>
                                        cancelCount
                                    </th>
                                    <th>
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>


                            <% users.forEach((user,index) => { %>


                                <tr>


                                    <!-- FIRST NAME -->

                                    <td>

                                        <%= user.firstName %>

                                    </td>


                                    <!-- LAST NAME -->

                                    <td>

                                        <%= user.lastName %>

                                    </td>


                                    <!-- EMAIL -->

                                    <td>

                                        <%= user.email %>

                                    </td>


                                    <!-- PHONE -->

                                    <td>

                                        <%= user.phoneNumber %>

                                    </td>


                                    <!-- STATUS -->

                                    <td>


                                        <% if(user.isBlocked) { %>


                                            <span
                                                class="status-blocked">

                                                <i class="bi bi-lock-fill"></i>

                                                Blocked

                                            </span>


                                        <% } else { %>


                                            <span
                                                class="status-active">

                                                <i class="bi bi-check-circle-fill"></i>

                                                Active

                                            </span>


                                        <% } %>


                                    </td>

                                    <td>

                                        <%= cancelDetails[index].count %>

                                    </td>
                                    <!-- ACTION -->

                                    <td>


                                        <% if(user.isBlocked) { %>


                                            <form
                                                action="/admin/unblock/<%= user._id %>"
                                                method="POST"
                                                class="d-inline">


                                                <button
                                                    type="submit"
                                                    class="btn btn-success btn-sm action-btn">

                                                    <i class="bi bi-unlock"></i>

                                                    Unblock

                                                </button>


                                            </form>


                                        <% } else { %>


                                            <form
                                                action="/admin/block/<%= user._id %>"
                                                method="POST"
                                                class="d-inline">


                                                <button
                                                    type="submit"
                                                    class="btn btn-danger btn-sm action-btn">

                                                    <i class="bi bi-lock"></i>

                                                    Block

                                                </button>


                                            </form>


                                        <% } %>


                                    </td>


                                </tr>


                            <% }) %>


                            </tbody>


                        </table>

                    </div>


                </div>



                <!-- ==================================
                     PAGINATION
                =================================== -->

                <nav class="mt-4">

                    <ul class="pagination justify-content-center">


                        <% for(let i = 1; i <= totalPages; i++) { %>


                            <li
                                class="page-item <%= currentPage === i ? 'active' : '' %>">


                                <a
                                    class="page-link"
                                    href="/admin/userManagement?page=<%= i %>&search=<%= search %>">

                                    <%= i %>

                                </a>


                            </li>


                        <% } %>


                    </ul>

                </nav>


            </div>

        </div>


    </div>

</div>



<!-- ==========================================
     SWEETALERT
=========================================== -->

<script>

    const alertData =
        <%- JSON.stringify(alert || null) %>;


    if (alertData) {

        Swal.fire({

            icon:
                alertData.type,

            title:
                alertData.message,

            confirmButtonText:
                "OK"

        });

    }

</script>



<!-- Bootstrap JS -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


</body>

</html>

