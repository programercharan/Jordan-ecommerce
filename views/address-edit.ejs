<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Address</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { background-color: #f5f5f5; }

    .sidebar {
      background: #fff;
      padding: 20px;
      border-radius: 10px;
    }

    .sidebar a {
      display: block;
      padding: 10px;
      color: #333;
      text-decoration: none;
      border-radius: 5px;
      margin-bottom: 5px;
    }

    .sidebar a.active {
      background-color: #0d6efd;
      color: #fff;
      font-weight: bold;
    }

    .form-card {
      background: #fff;
      padding: 25px;
      border-radius: 10px;
    }
  </style>
</head>

<body>

<div class="container mt-5">
  <div class="row">

    <!-- Sidebar -->
    <div class="col-md-3">
      <div class="sidebar">
        <h5>My Account</h5>

        <a href="/user/profile" class="<%= currentPage === 'profile' ? 'active' : '' %>">Profile</a>
        <a href="/user/address" class="<%= currentPage === 'address' ? 'active' : '' %>">Address</a>
        <a href="/user/orders" class="<%= currentPage === 'orders' ? 'active' : '' %>">Orders</a>
        <a href="/user/wishlist" class="<%= currentPage === 'wishlist' ? 'active' : '' %>">Wishlist</a>
        <a href="/user/wallet" class="<%= currentPage === 'wallet' ? 'active' : '' %>">My Wallet</a>
      </div>
    </div>

    <!-- Edit Form -->
    <div class="col-md-9">
      <div class="form-card">

        <h4 class="mb-4">Edit Address</h4>

        <form action="/user/updateAddress/<%= address._id %>"  id="edit-address"method="POST" novalidate>

          <div class="mb-3">
            <label>First Name</label>
            <input type="text" name="firstName" class="form-control" id="firstName" value="<%= address.firstName %>">
             <div style="min-height:1em;"><small id="firstNameError" class="text-danger"></small></div>
          </div>

          <div class="mb-3">
            <label>Last Name</label>
            <input type="text" name="lastName" class="form-control" id="lastName" value="<%= address.lastName %>">
            <div style="min-height:1em;"><small id="lastNameError" class="text-danger"></small></div>
          </div>

          <div class="mb-3">
            <label>Address</label>
            <textarea name="address" id="address" class="form-control"> <%= address.address %></textarea>
            <div style="min-height:1em;"><small id="addressError" class="text-danger"></small></div>
          </div>

          <div class="mb-3">
            <label>City</label>
            <input type="text" name="city" id="city" class="form-control" value="<%= address.city %>">
            <div style="min-height:1em;"><small id="cityError" class="text-danger"></small></div>
          </div>

          <div class="mb-3">
            <label>State</label>
            <input type="text" name="state" id="state" class="form-control" value="<%= address.state %>">
            <div style="min-height:1em;"><small id="stateError" class="text-danger"></small></div>
          </div>

          <div class="mb-3">
            <label>Pincode</label>
            <input type="text" name="pincode"  id="pincode" class="form-control" value="<%= address.pincode %>">
            <div style="min-height:1em;"><small id="pincodeError" class="text-danger"></small></div>
          </div>

          <div class="mb-3">
            <label>Phone Number</label>
            <input type="text" name="phoneNumber" id="phoneNumber" class="form-control" value="<%= address.phoneNumber %>">
            <div style="min-height:1em;"><small id="phoneNumberError" class="text-danger"></small></div>
          </div>

          <button type="submit" class="btn btn-primary">Update Address</button>
          <a href="/user/address" class="btn btn-secondary">Cancel</a>

        </form>

      </div>
    </div>

  </div>
</div>

</body>
<script>
    const form=document.getElementById("edit-address")
    form.addEventListener("submit",(e)=>{
        console.log(form)
        e.preventDefault()
        hasError=false

         const phoneRegex = /^[0-9]{10}$/;
         const firstName=document.getElementById("firstName").value.trim()
         const LastName=document.getElementById("lastName").value.trim()
         const address=document.getElementById("address").value.trim()
         const city=document.getElementById("city").value.trim()
         const state=document.getElementById("state").value.trim()
        const pincode=document.getElementById("pincode").value.trim()
        const phoneNumber=document.getElementById("phoneNumber").value.trim()

         const firstNameError=document.getElementById("firstNameError")
         const LastNameError=document.getElementById("lastNameError")
         const addressError=document.getElementById("addressError")
         const cityError=document.getElementById("cityError")
         const stateError=document.getElementById("stateError")
        const pincodeError=document.getElementById("pincodeError")
        const phoneNumberError=document.getElementById("phoneNumberError")

        firstNameError.innerText=""
        LastNameError.innerText=""
        addressError.innerText=""
        cityError.innerText=""
        stateError.innerText=""
        pincodeError.innerText=""
        phoneNumberError.innerText=""

        if(pincode===""){
            pincodeError.innerText="Enter pincode"
            hasError=true
        }
        else if(firstName===""){
        firstNameError.innerText="Enter firstName"  
        hasError=true          
        }
        else if(LastName===""){
        LastNameError.innerText="Enter LastName"  
        hasError=true          
        }
        else if(address===""){
        addressError.innerText="Enter address"  
        hasError=true          
        }
        else if(city===""){
        cityError.innerText="Enter city"  
        hasError=true          
        }
        else if(state===""){
        stateError.innerText="Enter state"  
        hasError=true          
        }
        else if(phoneNumber===""){
        phoneNumberError.innerText="Enter Phone Number"  
        hasError=true          
        }
        else if(pincode.length !==6){
            pincodeError.innerText="Enter Valid pincode"
            hasError=true
        }
        else if(!phoneRegex.test(phoneNumber)){
        phoneNumberError.innerText="Enter Valid Phone Number"  
        hasError=true 
        }
        if(!hasError){
            form.submit()
        }
    })
</script>
</html>