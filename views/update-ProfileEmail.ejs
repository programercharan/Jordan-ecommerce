<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>update ProfileEmail</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light d-flex justify-content-center align-items-center vh-100">

  <div class="card shadow p-4" style="width: 400px;">
    
      <% if (error) { %>
        <div class="alert alert-danger text-center">
          <%= error %>
        </div>
        <% } %>

    <!-- Heading -->
    <h4 class="fw-bold text-center mb-2">Update Email</h4>

    <!-- Content text -->
    <p class="text-muted text-center small mb-4">
      Enter your email address, we'll send you an OTP to change Email
    </p>

    <!-- Form -->
    <form action="/user/updateProfileEmail" method="post" id="update-profileEmail-form" novalidate>

      <!-- Email textbox -->
      <div class="mb-3">
        <input
          type="email"
          name="email"
          class="form-control"
          placeholder="Enter your email address"
          required
          id="updateProfileEmail"
        >
     <small id="updateProfileEmailError" class="text-danger"></small>
      </div>

      <!-- Send OTP button -->
      <div class="d-grid">
        <button type="submit"  class="btn btn-dark">
          Send OTP
        </button>
      </div>

    </form>

  </div>

</body>
</html>
<script>
    const form=document.getElementById("update-profileEmail-form")

    form.addEventListener("submit",(e)=>{
        e.preventDefault()
        const hasError=false
        const updateProfileEmailError=document.getElementById("updateProfileEmailError")
        updateProfileEmailError.innerText=""

        const updateProfileEmail=document.getElementById("updateProfileEmail").value.trim()
        const emailRegex = /^([A-Za-z0-9_\-\.])+\@([A-Za-z0-9_\-\.])+\.([A-Za-z]{2,4})$/;

        if(updateProfileEmail===""){
            updateProfileEmailError.innerText="Enter email"
            hasError=true
        }
        else if(!emailRegex.test(updateProfileEmail)){
             updateProfileEmailError.innerText="Enter Valid email"
             hasError=true
        }
        else if(!hasError){
          console.log("form submitted")
            form.submit()
        }
    })
</script>