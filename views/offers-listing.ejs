<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Offers</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >


<style>

    /* ==========================================
   SIDEBAR
========================================== */

.sidebar {

    background-color: #ffffff;

    min-height: 100vh;

    padding: 25px 18px;

    border-right: 1px solid #e5e7eb;

    position: sticky;

    top: 0;

}


.sidebar-title {

    font-size: 21px;

    font-weight: 700;

    margin-bottom: 30px;

    padding-left: 10px;

}


.sidebar-section {

    font-size: 11px;

    font-weight: 700;

    color: #8a8f98;

    text-transform: uppercase;

    margin-top: 20px;

    margin-bottom: 8px;

    padding-left: 10px;

}


.sidebar a {

    display: flex;

    align-items: center;

    gap: 10px;

    text-decoration: none;

    color: #555b65;

    padding: 11px 12px;

    margin-bottom: 4px;

    border-radius: 8px;

    font-size: 14px;

    transition: 0.2s;

}


.sidebar a:hover {

    background-color: #f1f3f5;

    color: #212529;

}


.sidebar a.active {

    background-color: #212529;

    color: #ffffff;

}


.sidebar hr {

    border: 0;

    border-top: 1px solid #eeeeee;

    margin: 20px 0;

}

.pagination-container {
    position: sticky;
    bottom: 0;
    background: #fff;
    padding: 12px 0;
    z-index: 100;
    border-top: 1px solid #e5e7eb;
}


/* ==========================================
   MOBILE
========================================== */

@media (max-width: 767px) {

    .sidebar {

        min-height: auto;

        position: relative;

        border-right: none;

        border-bottom: 1px solid #e5e7eb;

    }

}
</style>

</head>


<body>


<div class="container-fluid">

    <div class="row">


<!-- ================================================= -->
<!-- SIDEBAR -->
<!-- ================================================= -->

<div class="col-md-3 col-lg-2 p-0">


    <div class="sidebar">


        <!-- SIDEBAR TITLE -->

        <div class="sidebar-title">

            Admin Panel

        </div>


        <!-- ==========================================
             MANAGEMENT
        =========================================== -->

        <div class="sidebar-section">

            Management

        </div>


        <!-- DASHBOARD -->

        <a
            href="/admin/dashboard"
            class="<%= currentSideBar === 'dashboard' ? 'active' : '' %>"
        >

            <i class="bi bi-speedometer2"></i>

            Dashboard

        </a>


        <!-- USERS -->

        <a
            href="/admin/userManagement"
            class="<%= currentSideBar === 'users' ? 'active' : '' %>"
        >

            <i class="bi bi-people"></i>

            Users

        </a>


        <hr>


        <!-- ==========================================
             CATALOG MANAGEMENT
        =========================================== -->

        <div class="sidebar-section">

            Catalog Management

        </div>


        <!-- CATEGORIES -->

        <a
            href="/admin/category/categories"
            class="<%= currentSideBar === 'categories' ? 'active' : '' %>"
        >

            <i class="bi bi-tags"></i>

            Categories

        </a>


        <!-- PRODUCTS -->

        <a
            href="/admin/product/products"
            class="<%= currentSideBar === 'product' ? 'active' : '' %>"
        >

            <i class="bi bi-box-seam"></i>

            Products

        </a>


        <hr>


        <!-- ==========================================
             ORDER MANAGEMENT
        =========================================== -->

        <div class="sidebar-section">

            Order Management

        </div>


        <!-- ORDERS -->

        <a
            href="/admin/orders"
            class="<%= currentSideBar === 'orders' ? 'active' : '' %>"
        >

            <i class="bi bi-cart-check"></i>

            Orders

        </a>


        <!-- COUPONS -->

        <a
            href="/admin/coupons"
            class="<%= currentSideBar === 'coupons' ? 'active' : '' %>"
        >

            <i class="bi bi-ticket-perforated"></i>

            Coupons

        </a>


        <!-- OFFERS -->

        <a
            href="/admin/offers/list"
            class="<%= currentSideBar === 'offers' ? 'active' : '' %>"
        >

            <i class="bi bi-percent"></i>

            Offers

        </a>


        <hr>


        <!-- ==========================================
             REPORTS
        =========================================== -->

        <div class="sidebar-section">

            Reports

        </div>


        <!-- SALES REPORT -->

        <a
            href="/admin/sales-report"
            class="<%= currentSideBar === 'salesReport' ? 'active' : '' %>"
        >

            <i class="bi bi-bar-chart-line"></i>

            Sales Report

        </a>


        <hr>


        <!-- LOGOUT -->

        <a
            href="/admin/logout"
            class="text-danger fw-bold"
        >

            <i class="bi bi-box-arrow-right"></i>

            Logout

        </a>


    </div>


</div>




        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <div class="col-lg-10 min-vh-100 p-4">


            <!-- HEADER -->

            <div
                class="d-flex justify-content-between align-items-center mb-4"
            >

                <div>

                    <h3 class="fw-bold mb-1">
                        Offers
                    </h3>

                    <p class="text-muted mb-0">
                        Manage product and category offers.
                    </p>

                </div>


                <a
                    href="/admin/offers"
                    class="btn btn-dark"
                >

                    <i class="bi bi-plus-circle me-1"></i>

                    Create Offer

                </a>

            </div>


            <!-- ================================================= -->
            <!-- ERROR -->
            <!-- ================================================= -->

            <% if (typeof error !== "undefined" && error) { %>

                <div class="alert alert-danger">

                    <%= error %>

                </div>

            <% } %>


            <!-- ================================================= -->
            <!-- OFFERS TABLE -->
            <!-- ================================================= -->

            <div class="card border-0 shadow-sm">

                <div class="card-body p-0">


                    <% if (offers && offers.length > 0) { %>


                        <div class="table-responsive">

                            <table
                                class="table table-hover mb-0"
                            >

                                <thead class="table-light">

                                    <tr>

                                        <th class="px-3">
                                            #
                                        </th>

                                        <th>
                                            Offer Name
                                        </th>

                                        <th>
                                            Type
                                        </th>

                                        <th>
                                            Product / Category
                                        </th>

                                        <th>
                                            Discount
                                        </th>

                                        <th>
                                            End Date
                                        </th>

                                        <th>
                                            Status
                                        </th>

                                        <th>
                                            Actions
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>


                                    <% offers.forEach((offer, index) => { %>


                                        <tr>


                                            <!-- NUMBER -->

                                            <td class="px-3">

                                                <%= index + 1 %>

                                            </td>


                                            <!-- OFFER NAME -->

                                            <td>

                                                <strong>
                                                    <%= offer.offerName %>
                                                </strong>

                                            </td>


                                            <!-- TYPE -->

                                            <td>

                                                <% if (offer.offerType === "product") { %>

                                                    <span
                                                        class="badge bg-primary"
                                                    >

                                                        Product

                                                    </span>

                                                <% } else { %>

                                                    <span
                                                        class="badge bg-info text-dark"
                                                    >

                                                        Category

                                                    </span>

                                                <% } %>

                                            </td>



                                            <!-- PRODUCT / CATEGORY -->

<td>

    <% if (offer.offerType === "product") { %>

        <% if (offer.productId && offer.productId.length > 0) { %>

            <div class="d-flex flex-wrap gap-1">

                <% offer.productId.forEach(product => { %>

                    <% if (product) { %>

                        <span class="badge bg-primary">

                            <%= product.name %>

                        </span>

                    <% } %>

                <% }) %>

            </div>

        <% } else { %>

            <span class="text-muted">
                Product unavailable
            </span>

        <% } %>


    <% } else { %>

        <% if (offer.categoryId && offer.categoryId.length > 0) { %>

            <div class="d-flex flex-wrap gap-1">

                <% offer.categoryId.forEach(category => { %>

                    <% if (category) { %>

                        <span class="badge bg-info text-dark">

                            <%= category.categoryName %>

                        </span>

                    <% } %>

                <% }) %>

            </div>

        <% } else { %>

            <span class="text-muted">
                Category unavailable
            </span>

        <% } %>

    <% } %>

</td>


                                            <!-- DISCOUNT -->

                                            <td>

                                                <strong>
                                                    <%= offer.discountPercentage %>%
                                                </strong>

                                            </td>


                                            <!-- END DATE -->

                                            <td>

                                                <%= new Date(
                                                    offer.endDate
                                                ).toLocaleDateString("en-IN") %>

                                            </td>


                                            <!-- STATUS -->

                                            <td>

                                                <%
                                                    const today = new Date();
                                                    const expiryDate = new Date(offer.endDate);

                                                    let status;

                                                    if (expiryDate <= today) {

                                                        status = "expired";

                                                    } else if (offer.isActive) {

                                                        status = "active";

                                                    } else {

                                                        status = "inactive";

                                                    }
                                                %>


                                                <% if (status === "active") { %>

                                                    <span
                                                        class="badge bg-success"
                                                    >

                                                        Active

                                                    </span>

                                                <% } else if (status === "inactive") { %>

                                                    <span
                                                        class="badge bg-secondary"
                                                    >

                                                        Inactive

                                                    </span>

                                                <% } else { %>

                                                    <span
                                                        class="badge bg-danger"
                                                    >

                                                        Expired

                                                    </span>

                                                <% } %>

                                            </td>


                                            <!-- ACTIONS -->

                                            <td>

                                                <div class="d-flex gap-2">


                                                    <!-- EDIT -->

                                                    <a
                                                        href="/admin/offers/edit/<%= offer._id %>"
                                                        class="btn btn-sm btn-outline-primary"
                                                    >

                                                        <i class="bi bi-pencil"></i>

                                                        Edit

                                                    </a>


                                                    <!-- DELETE -->

                                                    <form
                                                        action="/admin/offers/delete/<%= offer._id %>"
                                                        method="POST"
                                                        class="deleteOfferForm"
                                                    >

                                                        <button
                                                            type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                        >

                                                            <i class="bi bi-trash"></i>

                                                            Delete

                                                        </button>

                                                    </form>


                                                </div>

                                            </td>


                                        </tr>


                                    <% }) %>


                                </tbody>

                            </table>

                        </div>


                    <% } else { %>


                        <!-- EMPTY STATE -->

                        <div class="text-center p-5">

                            <i
                                class="bi bi-percent fs-1 text-muted"
                            ></i>


                            <h5 class="mt-3">
                                No Offers Found
                            </h5>


                            <p class="text-muted">
                                You haven't created any offers yet.
                            </p>


                            <a
                                href="/admin/offers"
                                class="btn btn-dark"
                            >

                                Create Your First Offer

                            </a>

                        </div>


                    <% } %>


                </div>

            </div>


        </div>

    </div>

</div>
<% if (totalPages > 1) { %>

    <div class="pagination-container d-flex justify-content-center">

        <nav aria-label="Offers pagination">

            <ul class="pagination mb-0">

                <!-- Previous -->

                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">

                    <a
                        class="page-link pagination-link"
                        href="#"
                        data-page="<%= currentPage - 1 %>"
                    >
                        Previous
                    </a>

                </li>


                <!-- Page Numbers -->

                <% for (let i = 1; i <= totalPages; i++) { %>

                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">

                        <a
                            class="page-link pagination-link"
                            href="#"
                            data-page="<%= i %>"
                        >
                            <%= i %>
                        </a>

                    </li>

                <% } %>


                <!-- Next -->

                <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">

                    <a
                        class="page-link pagination-link"
                        href="#"
                        data-page="<%= currentPage + 1 %>"
                    >
                        Next
                    </a>

                </li>

            </ul>

        </nav>

    </div>

<% } %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


