<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Address</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

  <style>
    body {
      background-color: #f5f5f5;
    }

    .sidebar {
      background: #fff;
      padding: 20px;
      border-radius: 10px;
    }

    .sidebar a {
      display: block;
      padding: 10px;
      color: #333;
      text-decoration: none;
      border-radius: 5px;
      margin-bottom: 5px;
    }

    .sidebar a.active {
      background-color: #0d6efd;
      color: #fff;
      font-weight: bold;
    }

    .form-card {
      background: #fff;
      padding: 25px;
      border-radius: 10px;
    }
  </style>
</head>

<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">

        <a class="navbar-brand fw-bold" href="/user/home">
            JORDAN
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">

            <ul class="navbar-nav">

                <li class="nav-item">
                    <a class="nav-link" href="/user/home">Home</a>
                </li>
 <li class="nav-item">

    <a
        class="nav-link position-relative"
        href="/user/wishlist"
    >

        <i class="bi bi-heart fs-5"></i>

        <% if (wishlistCount > 0) { %>

            <span
                class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
            >

                <%= wishlistCount %>

            </span>

        <% } %>

    </a>

</li>
<li class="nav-item">
    <a class="nav-link position-relative" href="/user/cart">
        <i class="bi bi-cart3 fs-5"></i>
        
        <% if (locals.cartCount && cartCount > 0) { %>
            <span
                class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
            >
                <%= cartCount %>
            </span>
        <% } %>
    </a>
</li>

                <li class="nav-item">
                    <a class="nav-link" href="/user/profile">Profile</a>
                </li>

            </ul>

        </div>

    </div>
</nav>

<div class="container mt-5">
  <div class="row">

    <!-- Sidebar -->
    <div class="col-md-3">
      <div class="sidebar">
        <h5>My Account</h5>

        <a href="/user/profile" 
           class="<%= currentPage === 'profile' ? 'active' : '' %>">
           Profile
        </a>

        <a href="/user/address" 
           class="<%= currentPage === 'address' ? 'active' : '' %>">
           Address
        </a>

        <a href="/user/orders" 
           class="<%= currentPage === 'orders' ? 'active' : '' %>">
           Orders
        </a>

        <a href="/user/wishlist" 
           class="<%= currentPage === 'wishlist' ? 'active' : '' %>">
           Wishlist
        </a>

        <a href="/user/wallet" 
           class="<%= currentPage === 'wallet' ? 'active' : '' %>">
           My Wallet
        </a>
      </div>
    </div>

    <!-- Add Address Form -->
    <div class="col-md-9">
      <div class="form-card">

        <h4 class="mb-4">Add New Address</h4>

        <form action="/user/addaddress" method="POST" id="add-address" novalidate>

          <!-- First Name -->
          <div style="min-height:1em;"><small id="credentialError" class="text-danger"></small></div>
          <div class="mb-3">
            <label class="form-label">First Name</label>
            <input type="text" name="firstName" class="form-control" id="firstName" required>
            <div style="min-height:1em;"><small id="firstNameError" class="text-danger"></small></div>
          </div>

            <div class="mb-3">
            <label class="form-label">Last Name</label>
            <input type="text" name="LastName" class="form-control" id="lastName" required>
            <div style="min-height:1em;"><small id="lastNameError" class="text-danger"></small></div>
          </div>
          <!-- Address -->
          <div class="mb-3">
            <label class="form-label">Address</label>
            <textarea name="address" class="form-control" id="address" rows="3" required></textarea>
            <div style="min-height:1em;"><small id="addressError" class="text-danger"></small></div>
          </div>

          <!-- City -->
          <div class="mb-3">
            <label class="form-label">City</label>
            <input type="text" name="city" class="form-control" id="city" required>
            <div style="min-height:1em;"><small id="cityError" class="text-danger"></small></div>
          </div>

          <!-- State -->
          <div class="mb-3">
            <label class="form-label">State</label>
            <input type="text" name="state" class="form-control" id="state" required>
            <div style="min-height:1em;"><small id="stateError" class="text-danger"></small></div>
          </div>

          <!-- Pincode -->
          <div class="mb-3">
            <label class="form-label">Pincode</label>
            <input type="text" name="pincode" id="pincode" class="form-control" required>
             <div style="min-height:1em;"><small id="pincodeError" class="text-danger"></small></div>
          </div>

          <!-- Phone Number -->
          <div class="mb-3">
            <label class="form-label">Phone Number</label>
            <input type="text" name="phoneNumber" id="phoneNumber" class="form-control" required>
            <div style="min-height:1em;"><small id="phoneNumberError" class="text-danger"></small></div>
          </div>

          <!-- Buttons -->
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              Save Address
            </button>

            <a href="/user/addaddress" class="btn btn-secondary">
              Cancel
            </a>
          </div>

        </form>

      </div>
    </div>

  </div>
</div>

</body>
</html>
<script>

    const form=document.getElementById("add-address")

    form.addEventListener("submit",(e)=>{

        e.preventDefault()

        let hasError=false

        const phoneRegex = /^[0-9]{10}$/;

        const firstName=document.getElementById("firstName").value.trim()
        const LastName=document.getElementById("lastName").value.trim()
        const address=document.getElementById("address").value.trim()
        const city=document.getElementById("city").value.trim()
        const state=document.getElementById("state").value.trim()
        const pincode=document.getElementById("pincode").value.trim()
        const phoneNumber=document.getElementById("phoneNumber").value.trim()


        const firstNameError=document.getElementById("firstNameError")
        const LastNameError=document.getElementById("lastNameError")
        const addressError=document.getElementById("addressError")
        const cityError=document.getElementById("cityError")
        const stateError=document.getElementById("stateError")
        const pincodeError=document.getElementById("pincodeError")
        const phoneNumberError=document.getElementById("phoneNumberError")
        const credentialError=document.getElementById("credentialError")


        // Clear old errors

        firstNameError.innerText=""
        LastNameError.innerText=""
        addressError.innerText=""
        cityError.innerText=""
        stateError.innerText=""
        pincodeError.innerText=""
        phoneNumberError.innerText=""
        credentialError.innerText=""


        // All fields empty

        if(
            firstName==="" &&
            LastName==="" &&
            address==="" &&
            city==="" &&
            state==="" &&
            pincode==="" &&
            phoneNumber===""
        ){

            credentialError.innerText="All Fields Are Required"

            hasError=true

        }


        // First Name

        if(firstName===""){

            firstNameError.innerText="Enter firstName"

            hasError=true

        }


        // Last Name

        if(LastName===""){

            LastNameError.innerText="Enter LastName"

            hasError=true

        }


        // Address

        if(address===""){

            addressError.innerText="Enter address"

            hasError=true

        }


        // City

        if(city===""){

            cityError.innerText="Enter city"

            hasError=true

        }


        // State

        if(state===""){

            stateError.innerText="Enter state"

            hasError=true

        }


        // Pincode

        if(pincode===""){

            pincodeError.innerText="Enter pincode"

            hasError=true

        }
        else if(pincode.length!==6){

            pincodeError.innerText="Enter Valid pincode"

            hasError=true

        }


        // Phone Number

        if(phoneNumber===""){

            phoneNumberError.innerText="Enter Phone Number"

            hasError=true

        }
        else if(!phoneRegex.test(phoneNumber)){

            phoneNumberError.innerText="Enter Valid Phone Number"

            hasError=true

        }


        // Submit

        if(!hasError){

            form.submit()

        }

    })


    // ==========================================
    // DYNAMIC ERROR REMOVAL
    // ==========================================


    // First Name

    document.getElementById("firstName").addEventListener("input",()=>{

        const value =
        document.getElementById("firstName").value.trim()

        if(value!==""){

            document.getElementById("firstNameError").innerText=""

            document.getElementById("credentialError").innerText=""

        }

    })


    // Last Name

    document.getElementById("lastName").addEventListener("input",()=>{

        const value =
        document.getElementById("lastName").value.trim()

        if(value!==""){

            document.getElementById("lastNameError").innerText=""

            document.getElementById("credentialError").innerText=""

        }

    })


    // Address

    document.getElementById("address").addEventListener("input",()=>{

        const value =
        document.getElementById("address").value.trim()

        if(value!==""){

            document.getElementById("addressError").innerText=""

            document.getElementById("credentialError").innerText=""

        }

    })


    // City

    document.getElementById("city").addEventListener("input",()=>{

        const value =
        document.getElementById("city").value.trim()

        if(value!==""){

            document.getElementById("cityError").innerText=""

            document.getElementById("credentialError").innerText=""

        }

    })


    // State

    document.getElementById("state").addEventListener("input",()=>{

        const value =
        document.getElementById("state").value.trim()

        if(value!==""){

            document.getElementById("stateError").innerText=""

            document.getElementById("credentialError").innerText=""

        }

    })


    // Pincode

    document.getElementById("pincode").addEventListener("input",()=>{

        const value =
        document.getElementById("pincode").value.trim()

        if(value.length===6){

            document.getElementById("pincodeError").innerText=""

            document.getElementById("credentialError").innerText=""

        }

    })


    // Phone Number

    document.getElementById("phoneNumber").addEventListener("input",()=>{

        const value =
        document.getElementById("phoneNumber").value.trim()

        const phoneRegex = /^[0-9]{10}$/;

        if(phoneRegex.test(value)){

            document.getElementById("phoneNumberError").innerText=""

            document.getElementById("credentialError").innerText=""

        }

    })

</script>